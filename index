            try {
                const savedGasUrl = localStorage.getItem('tamaland_gas_url') || DEFAULT_CLOUD_SCRIPT_URL;
                const savedGasToken = localStorage.getItem('tamaland_gas_token') || DEFAULT_CLOUD_SECRET_TOKEN;

                const saved = localStorage.getItem('tamaland_state_v5');
                if (saved) {
                    const parsed = JSON.parse(saved);
                    if (parsed.wargaList) state.wargaList = parsed.wargaList;
                    if (parsed.calonWargaList) state.calonWargaList = parsed.calonWargaList;
                    if (parsed.iuranList) state.iuranList = parsed.iuranList;
                    if (parsed.transaksiList) state.transaksiList = parsed.transaksiList;
                    if (parsed.pengeluaranList) state.pengeluaranList = parsed.pengeluaranList;
                    if (parsed.pengurusList) state.pengurusList = parsed.pengurusList;
                    if (parsed.ratingList) state.ratingList = parsed.ratingList;
                    if (parsed.meterAirList) state.meterAirList = parsed.meterAirList;
                    if (parsed.accessLogList) state.accessLogList = parsed.accessLogList;
                    if (parsed.pesanList) state.pesanList = parsed.pesanList;
                    if (parsed.tarifAirKubik !== undefined) state.tarifAirKubik = Number(parsed.tarifAirKubik) || 3500;
                    if (parsed.identitas) state.identitas = { ...state.identitas, ...parsed.identitas };
                    if (parsed.kategoriRates) state.kategoriRates = parsed.kategoriRates;
                    if (parsed.rolePermissions) state.rolePermissions = parsed.rolePermissions;
                }
                
                if (!state.identitas) state.identitas = {};
                if (!state.identitas.cloudScriptUrl || state.identitas.cloudScriptUrl.includes('...')) {
                    state.identitas.cloudScriptUrl = savedGasUrl;
                }
                localStorage.setItem('tamaland_gas_url', state.identitas.cloudScriptUrl);

                if (!state.identitas.cloudSecretToken) {
                    state.identitas.cloudSecretToken = savedGasToken;
                }
                localStorage.setItem('tamaland_gas_token', state.identitas.cloudSecretToken);
            } catch (e) {
                console.warn("Gagal memuat dari localStorage:", e);
            }
        }

