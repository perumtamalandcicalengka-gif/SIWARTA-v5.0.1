        let pendingUpdateAppFileData = null;

        function handleUpdateAppFileSelect(inputElem) {
            pendingUpdateAppFileData = null;
            if (!inputElem || !inputElem.files || !inputElem.files[0]) return;
            const file = inputElem.files[0];
            const maxBytes = 4 * 1024 * 1024;
            if (file.size > maxBytes) {
                Swal.fire({ icon: 'warning', title: 'File Terlalu Besar', text: 'Ukuran file maksimal 4 MB. Untuk file lebih besar, masukkan tautan HTTPS.' });
                inputElem.value = '';
                return;
            }
            const reader = new FileReader();
            reader.onload = function(evt) {
                pendingUpdateAppFileData = {
                    name: file.name,
                    dataUrl: evt.target.result
                };
                const urlInput = document.getElementById('updateAppUrlInput');
                if (urlInput && !urlInput.value.trim()) {
                    urlInput.value = file.name;
                }
            };
            reader.readAsDataURL(file);
        }

        function saveUpdateAppWarga(e) {
            if (e) e.preventDefault();
            const versi = (document.getElementById('updateAppVersiInput')?.value || '').trim();
            const sasaran = document.getElementById('updateAppSasaranSelect')?.value || 'SEMUA';
            const blokTarget = (document.getElementById('updateAppBlokTargetInput')?.value || '').trim().toUpperCase();
            const rawUrl = (document.getElementById('updateAppUrlInput')?.value || '').trim();
            const catatan = (document.getElementById('updateAppCatatanInput')?.value || '').trim();

            if (!versi || !catatan) {
                Swal.fire({ icon: 'warning', title: 'Data Belum Lengkap', text: 'Isi versi aplikasi dan catatan pembaruan terlebih dahulu.' });
                return;
            }
            if (sasaran === 'BLOK_TERTENTU' && !blokTarget) {
                Swal.fire({ icon: 'warning', title: 'Blok Tujuan Kosong', text: 'Masukkan nomor blok warga sasaran.' });
                return;
            }

            let safeDownloadHref = sanitizeSafeExternalURL(rawUrl);
            let fileNameLabel = rawUrl;
            if (!safeDownloadHref && pendingUpdateAppFileData && pendingUpdateAppFileData.dataUrl) {
                safeDownloadHref = pendingUpdateAppFileData.dataUrl;
                fileNameLabel = pendingUpdateAppFileData.name;
            }
            if (!safeDownloadHref) {
                Swal.fire({ icon: 'warning', title: 'Tautan / File Belum Valid', text: 'Masukkan tautan https:// atau pilih berkas pembaruan.' });
                return;
            }

            if (!state.identitas) state.identitas = {};
            state.identitas.updateAppWarga = {
                versi,
                sasaran,
                blokTarget: sasaran === 'BLOK_TERTENTU' ? blokTarget : 'SEMUA',
                downloadUrl: safeDownloadHref,
                fileName: fileNameLabel || `SIWARTA_${versi}`,
                catatan,
                diperbaruiPada: formatJakartaFullTimestamp(new Date())
            };

            pendingUpdateAppFileData = null;
            if (document.getElementById('updateAppFileInput')) document.getElementById('updateAppFileInput').value = '';

            saveToLocalStorage();
            renderUpdateAppAdminAndWarga();
            syncDataToGoogleSheets(true, 'Identitas');

            Swal.fire({
                icon: 'success',
                title: 'Update Aplikasi Dipublikasikan',
                text: `Versi ${versi} siap diunduh oleh warga pada Portal Mandiri Warga.`,
                timer: 1500,
                showConfirmButton: false
            });
        }

