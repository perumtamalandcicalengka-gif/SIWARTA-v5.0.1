        function getDeviceSummary() {
            try {
                const ua = navigator.userAgent || '';
                let os = 'Desktop';
                if (/Android/i.test(ua)) os = 'Android';
                else if (/iPhone|iPad|iPod/i.test(ua)) os = 'iOS';
                else if (/Windows/i.test(ua)) os = 'Windows';
                else if (/Mac/i.test(ua)) os = 'MacOS';
                return `${os} • Web`;
            } catch (e) {
                return 'Web Browser';
            }
        }

        function recordAccessLog({ userId = '-', nama = '-', role = '-', aktivitas = 'Login Sistem', status = 'Berhasil' }) {
            const waktuWIB = formatJakartaFullTimestamp(new Date());

            const entry = {
                id: generateUniqueId('LOG'),
                waktu: waktuWIB,
                userId: String(userId || '-'),
                nama: String(nama || '-'),
                role: String(role || '-'),
                aktivitas: String(aktivitas || 'Login Sistem'),
                status: String(status || 'Berhasil'),
                device: getDeviceSummary()
            };

            if (!state.accessLogList) state.accessLogList = [];
            state.accessLogList.unshift(entry);
            if (state.accessLogList.length > 300) {
                state.accessLogList = state.accessLogList.slice(0, 300);
            }

            saveToLocalStorage();
            renderTableAccessLog();
            syncDataToGoogleSheets(true, 'LogAkses');
