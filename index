        function getTransactionCashAmount(t) {
            if (t.statusBayar === 'Kurang Bayar' || t.statusBayar === 'KurangBayar' || t.statusBayar === 'Belum Lunas / Kurang Bayar') {
                return Number(t.nominalDibayarSekarang !== undefined ? t.nominalDibayarSekarang : ((t.nominal || 0) - (t.kekurangan || 0))) || 0;
            }
            return Number(t.nominalDibayarSekarang !== undefined ? t.nominalDibayarSekarang : t.nominal) || 0;
        }

        function getWargaTarifSeharusnya(warga, categoryId = '1') {
            if (categoryId === 'air') return 0;
            let totalTarifDasar = 0;
            (state.iuranList || []).forEach(i => {
                if (i.wajib) totalTarifDasar += Number(i.nominal) || 0;
            });
            if (totalTarifDasar === 0) totalTarifDasar = 50000;

            const kat = (warga?.kategori || 'Mampu (Bayar Full)').toLowerCase();
            if (kat.includes('subsidi') || kat.includes('bebas')) {
                const rateSub = state.kategoriRates?.['Subsidi / Bebas'] ?? 0;
                return Math.round(totalTarifDasar * (rateSub / 100));
            }
            if (kat.includes('diskon')) {
                const rateDiskon = state.kategoriRates?.['Diskon Khusus'] ?? 50;
                return Math.round(totalTarifDasar * (rateDiskon / 100));
            }
            const rateFull = state.kategoriRates?.['Mampu (Bayar Full)'] ?? 100;
            return Math.round(totalTarifDasar * (rateFull / 100));
        }

        function updateHeaderStats() {
            let totalPemasukanIuran = 0;
            let totalPemasukanAir = 0;
            let totalPiutang = 0;
            const pendingTrx = [];

            (state.transaksiList || []).forEach(t => {
                const isPending = t.metode === 'Transfer Mandiri' && (t.validasiAdmin === 'Menunggu Validasi' || t.validasiAdmin === 'Pending');
                if (isPending) {
                    pendingTrx.push(t);
                    return;
                }
                if (t.validasiAdmin === 'Ditolak') return;

                const isAir = t.categoryId === 'air' || (t.metode || '').toLowerCase().includes('air') || t.metode === 'Tagihan Air';
                const cashNom = getTransactionCashAmount(t);

                if (t.statusBayar === 'Lunas' || t.statusBayar === 'Sudah Dilunasi' || (t.validasiAdmin === 'Disetujui' && t.statusBayar !== 'Belum Lunas' && t.statusBayar !== 'Kurang Bayar' && t.statusBayar !== 'Belum Lunas / Kurang Bayar')) {
                    if (isAir) totalPemasukanAir += cashNom;
                    else totalPemasukanIuran += cashNom;
                } else if (t.statusBayar === 'Kurang Bayar' || t.statusBayar === 'Belum Lunas / Kurang Bayar') {
                    if (isAir) totalPemasukanAir += cashNom;
                    else totalPemasukanIuran += cashNom;
                    totalPiutang += Number(t.kekurangan) || 0;
                } else {
                    totalPiutang += Number(t.nominal) || 0;
                }
            });

            const totalPemasukan = totalPemasukanIuran + totalPemasukanAir;
            const totalPengeluaran = (state.pengeluaranList || []).reduce((sum, p) => sum + (Number(p.nominal) || 0), 0);
            const saldoKas = totalPemasukan - totalPengeluaran;
            const totalWarga = (state.wargaList || []).length;
            const totalJiwaWarga = (state.wargaList || []).reduce((sum, w) => sum + (Number(w.anggota) || 1), 0);

            if (document.getElementById('statSaldoKas')) document.getElementById('statSaldoKas').innerText = formatRupiah(saldoKas);
            if (document.getElementById('statTotalPemasukan')) document.getElementById('statTotalPemasukan').innerText = formatRupiah(totalPemasukan);
            if (document.getElementById('statPemasukanBreakdown')) {
                document.getElementById('statPemasukanBreakdown').innerText = `Iuran: ${formatRupiah(totalPemasukanIuran)} • Air: ${formatRupiah(totalPemasukanAir)}`;
            }
            if (document.getElementById('statTagihanBelumLunas')) {
                document.getElementById('statTagihanBelumLunas').innerText = `Piutang: ${formatRupiah(totalPiutang)}`;
            }
            if (document.getElementById('statTotalPengeluaran')) document.getElementById('statTotalPengeluaran').innerText = formatRupiah(totalPengeluaran);
            if (document.getElementById('statTotalWarga')) document.getElementById('statTotalWarga').innerText = `${totalWarga} KK (${totalJiwaWarga} Jiwa)`;

            const notifCard = document.getElementById('adminPendingNotifCard');
            const notifText = document.getElementById('adminPendingNotifText');
            const notifQueue = document.getElementById('adminPendingNotifQueueList');
            if (notifCard) {
                if (pendingTrx.length > 0) {
                    notifCard.classList.remove('hidden');
                    if (notifText) notifText.innerText = `Terdapat ${pendingTrx.length} pembayaran transfer mandiri menunggu konfirmasi Anda.`;
                    if (notifQueue) {
                        notifQueue.innerHTML = pendingTrx.slice(0, 3).map(pt => `
                            <div class="flex items-center justify-between bg-white/80 px-2.5 py-1.5 rounded-lg border border-amber-200 text-[10px]">
                                <span class="font-bold text-slate-800">${escapeHTML(pt.noRumah)} - ${escapeHTML(pt.nama)} (${formatRupiah(pt.nominal)})</span>
                                <div class="space-x-1">
                                    <button onclick="approveTransferMandiri('${escapeHTML(pt.id)}')" class="px-2 py-0.5 bg-emerald-600 text-white font-bold rounded">Setuju</button>
                                    <button onclick="previewBuktiTransferAdmin('${escapeHTML(pt.id)}')" class="px-2 py-0.5 bg-slate-200 text-slate-700 font-bold rounded">Bukti</button>
                                </div>
                            </div>
                        `).join('');
                    }
                } else {
                    notifCard.classList.add('hidden');
                }
            }

            renderDashboardCharts();
        }

        function approveTransferMandiri(trxId) {
            const idx = (state.transaksiList || []).findIndex(t => t.id === trxId);
            if (idx !== -1) {
                const trx = state.transaksiList[idx];
                const warga = (state.wargaList || []).find(w => String(w.noRumah || '').trim().toUpperCase() === String(trx.noRumah || '').trim().toUpperCase());
                const tarifSeharusnya = Number(trx.tarifSeharusnya) || getWargaTarifSeharusnya(warga, trx.categoryId || '1');
                const nomDibayar = Number(trx.nominalDibayarSekarang !== undefined ? trx.nominalDibayarSekarang : trx.nominal) || 0;
                const isKurang = tarifSeharusnya > 0 && nomDibayar < tarifSeharusnya;

                state.transaksiList[idx].validasiAdmin = 'Disetujui';
                state.transaksiList[idx].tarifSeharusnya = tarifSeharusnya;
                state.transaksiList[idx].nominalDibayarSekarang = nomDibayar;
                state.transaksiList[idx].statusBayar = isKurang ? 'Belum Lunas / Kurang Bayar' : 'Lunas';
                state.transaksiList[idx].kekurangan = isKurang ? Math.max(0, tarifSeharusnya - nomDibayar) : 0;
                
                saveToLocalStorage();
                renderTableTransaksi();
                renderMatriksTunggakan();
                updateHeaderStats();
                syncDataToGoogleSheets(true, 'Transaksi');
                
                Swal.fire({
                    icon: isKurang ? 'warning' : 'success',
                    title: isKurang ? 'Disetujui (Kurang Bayar)' : 'Pembayaran Disetujui',
                    text: isKurang
                        ? `Nominal transfer (${formatRupiah(nomDibayar)}) kurang dari tarif ${formatRupiah(tarifSeharusnya)}. Status tercatat: Belum Lunas / Kurang Bayar.`
                        : 'Transfer mandiri warga telah divalidasi dan dicatat lunas ke kas!',
                    timer: 1800,
                    showConfirmButton: false
                });
            }
        }

        function renderDashboardCharts() {
            if (typeof Chart === 'undefined') return;

            const bulanLabels = ['Jan', 'Feb', 'Mar', 'Apr', 'Mei', 'Jun', 'Jul', 'Agu', 'Sep', 'Okt', 'Nov', 'Des'];
            const bulanFull = ['januari', 'februari', 'maret', 'april', 'mei', 'juni', 'juli', 'agustus', 'september', 'oktober', 'november', 'desember'];

            const canvasKas = document.getElementById('chartKas');
            if (canvasKas) {
                const dataMasukIuran = new Array(12).fill(0);
                const dataKeluarKas = new Array(12).fill(0);

                (state.transaksiList || []).forEach(t => {
                    const isApproved = t.validasiAdmin !== 'Ditolak' && !(t.metode === 'Transfer Mandiri' && (t.validasiAdmin === 'Menunggu Validasi' || t.validasiAdmin === 'Pending'));
                    if (!isApproved || t.statusBayar === 'Belum Lunas') return;
                    
                    const isAir = t.categoryId === 'air' || (t.metode || '').toLowerCase().includes('air') || t.metode === 'Tagihan Air';
                    if (isAir) return;

                    const cashNom = getTransactionCashAmount(t);
                    const pStr = formatPeriodeBulan(t.bulan || t.tanggal).toLowerCase();
                    const idx = bulanFull.findIndex(b => pStr.includes(b));
                    if (idx !== -1) dataMasukIuran[idx] += cashNom;
                });

                (state.pengeluaranList || []).forEach(p => {
                    const cleanDate = formatCleanDate(p.tanggal);
                    const parts = cleanDate.split('-');
                    if (parts.length === 3) {
                        const mIdx = parseInt(parts[1], 10) - 1;
                        if (mIdx >= 0 && mIdx < 12) dataKeluarKas[mIdx] += Number(p.nominal) || 0;
                    }
                });

                if (chartKasInstance) chartKasInstance.destroy();
