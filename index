                }
            }).catch(() => {
                if (statusText) statusText.innerText = 'Koneksi Gagal';
                if (statusBadge) {
                    statusBadge.className = 'flex items-center space-x-1 bg-rose-500/20 border border-rose-400/30 px-2 py-1 rounded-lg text-[9px] font-bold text-rose-300';
                }
                if (!silent) {
                    hideLoadingOverlay();
                    Swal.fire({ icon: 'error', title: 'Gagal Sinkronisasi', text: 'Periksa koneksi atau konfigurasi Web App.' });
                }
            });
        }

        function pullDataFromSheetSilent() {
            const cfg = getCloudConfig();
            const url = cfg.url;
            const secretToken = cfg.token;
            if (!url) return;

            const fetchUrl = url + (url.includes('?') ? '&' : '?') + 'token=' + encodeURIComponent(secretToken);

            fetchWithTimeout(fetchUrl, {}, 12000)
                .then(res => res.json())
                .then(res => {
                    if (res.status === 'unauthorized') return;
                    const sheetData = res.data || res.sheets || res;
                    if (sheetData) {
                        const identitasRows = sheetData.Identitas || sheetData.identitas;
                        if (identitasRows && Array.isArray(identitasRows) && identitasRows.length > 1) {
                            identitasRows.slice(1).forEach(r => {
                                const k = String(r[0] || '').trim();
                                const v = String(r[1] || '').trim();
                                if (k === 'Nama Perumahan' && v) state.identitas.namaPerumahan = v;
                                if (k === 'Alamat' && v) state.identitas.alamat = v;
                                if (k === 'Logo URL' && v) state.identitas.logoUrl = v;
                                if (k === 'TTD Bendahara URL' && v) state.identitas.ttdBendaharaUrl = v;
                                if (k === 'No Rekening' && v) state.identitas.noRekening = v;
                                if (k === 'QRIS URL' && v) state.identitas.qrisUrl = v;
                                if (k === 'Visual Theme' && v) state.identitas.theme = v;
                                if (k === 'Role Permissions JSON' && v) {
                                    try { state.rolePermissions = JSON.parse(v); } catch (e) {}
                                }
                            });
                        }

                        const wargaRows = sheetData.Warga || sheetData.warga;
                        if (wargaRows && Array.isArray(wargaRows) && wargaRows.length > 1) {
                            const rows = wargaRows.slice(1);
                            const wargaMap = new Map();
                            (state.wargaList || []).forEach(localW => {
                                const k = String(localW.noRumah || localW.id || '').trim().toUpperCase();
                                if (k) wargaMap.set(k, localW);
                            });
                            rows.forEach(r => {
                                const idVal = String(r[0] || '').trim();
                                const noRumahVal = String(r[1] || '').trim().toUpperCase();
                                const key = (noRumahVal || idVal).toUpperCase();
                                if (key) {
                                    const existingLocal = wargaMap.get(key);
                                    wargaMap.set(key, {
                                        id: idVal || (existingLocal ? existingLocal.id : generateUniqueId('w')),
                                        noRumah: noRumahVal,
                                        nama: String(r[2] || '').trim(),
                                        jalan: String(r[3] || '').trim(),
                                        anggota: Number(r[4]) || 1,
                                        wa: String(r[5] || '').trim(),
                                        kategori: String(r[6] || 'Mampu (Bayar Full)').trim(),
                                        pass: String(r[7] || 'warga123').trim(),
