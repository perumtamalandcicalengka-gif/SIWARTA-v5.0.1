        async function submitWajibGantiPasswordWarga(e) {
            if (e) e.preventDefault();
            if (!mandatoryPasswordTargetBlok) return;

            const passBaru = (document.getElementById('wajibPassBaruInput')?.value || '').trim();
            const passKonfirm = (document.getElementById('wajibPassKonfirmInput')?.value || '').trim();

            if (passBaru.length < 6) {
                Swal.fire({ icon: 'warning', title: 'Password Terlalu Pendek', text: 'Password baru minimal harus 6 karakter.' });
                return;
            }
            if (passBaru.toLowerCase() === 'warga123') {
                Swal.fire({ icon: 'warning', title: 'Gunakan Password Lain', text: 'Password baru tidak boleh menggunakan password default (warga123).' });
                return;
            }
            if (passBaru !== passKonfirm) {
                Swal.fire({ icon: 'error', title: 'Password Tidak Sama', text: 'Konfirmasi password baru harus sama persis.' });
                return;
            }

            const idx = (state.wargaList || []).findIndex(w => String(w.noRumah || '').trim().toUpperCase() === mandatoryPasswordTargetBlok);
            if (idx === -1) return;

            const hashedPass = await hashPasswordSHA256(passBaru);
            state.wargaList[idx].pass = hashedPass;
            state.wargaList[idx].passwordChanged = true;

            if (currentWargaUser && String(currentWargaUser.noRumah || '').trim().toUpperCase() === mandatoryPasswordTargetBlok) {
                currentWargaUser = state.wargaList[idx];
            }

            saveToLocalStorage();
            syncDataToGoogleSheets(true, 'Warga');

            recordAccessLog({
                userId: state.wargaList[idx].noRumah,
                nama: state.wargaList[idx].nama,
                role: 'Warga',
                aktivitas: 'Mengganti Password Default (Tersimpan Otomatis)',
                status: 'Berhasil'
            });

            const modal = document.getElementById('modalWajibGantiPasswordWarga');
            if (modal) modal.classList.add('hidden');
            mandatoryPasswordTargetBlok = null;

            Swal.fire({
                icon: 'success',
                title: 'Password Berhasil Diperbarui',
                text: 'Password baru Anda telah dienkripsi dan disimpan otomatis ke database.',
                timer: 1600,
                showConfirmButton: false
            });
        }

        async function handleAdminLogin(e) {
