        function captureSelfieFromCamera() {
            const videoEl = document.getElementById('selfieVideoPreview');
            const canvasEl = document.getElementById('selfieCaptureCanvas');
            if (!videoEl || !canvasEl) return;
            canvasEl.width = 320;
            canvasEl.height = 320;
            const ctx = canvasEl.getContext('2d');
            ctx.translate(320, 0);
            ctx.scale(-1, 1);
            ctx.drawImage(videoEl, 0, 0, 320, 320);
            const dataUrl = canvasEl.toDataURL('image/jpeg', 0.85);
            closeSelfieCameraModal();
            saveWargaSelfieBase64(dataUrl);
        }

