                Swal.fire({
                    icon: 'warning',
                    title: 'Akses Dikunci Sementara',
                    text: `Terlalu banyak percobaan gagal untuk "${userInput}". Coba lagi dalam ${rateCheck.secondsLeft} detik.`
                });
                return;
            }

            const matchedPengurus = (state.pengurusList || []).find(p =>
                String(p.username || '').trim().toLowerCase() === userInput.toLowerCase()
            );

            let authenticated = false;
            let loggedName = 'Administrator';
            let loggedRole = 'Admin Utama';

            if (matchedPengurus && matchedPengurus.password) {
                authenticated = await verifyPassword(passInput, matchedPengurus.password);
                loggedName = matchedPengurus.nama || matchedPengurus.username;
                loggedRole = matchedPengurus.jabatan || 'Admin Utama';
            } else if (userInput.toLowerCase() === 'admin') {
                const defaultAdminHash = await hashPasswordSHA256('Alhilalfh07');
                authenticated = (await hashPasswordSHA256(passInput)) === defaultAdminHash || passInput === 'Alhilalfh07';
                loggedName = 'Admin Utama';
                loggedRole = 'Admin Utama';
            }

            if (!authenticated) {
                recordFailedLoginAttempt('admin:' + userInput);
                recordAccessLog({
                    userId: userInput,
                    nama: matchedPengurus ? matchedPengurus.nama : userInput,
                    role: matchedPengurus ? matchedPengurus.jabatan : 'Pengurus',
                    aktivitas: 'Percobaan Login Dashboard Pengurus',
                    status: 'Gagal'
                });
                Swal.fire({ icon: 'error', title: 'Akses Ditolak', text: 'Username atau kata sandi pengurus tidak valid.' });
                return;
            }

            resetLoginAttempts('admin:' + userInput);
            currentUserRole = 'admin';
            currentAdminRole = loggedRole;
            currentWargaUser = null;

            recordAccessLog({
                userId: userInput,
                nama: loggedName,
                role: loggedRole,
                aktivitas: 'Login Dashboard Pengurus',
                status: 'Berhasil'
            });

            document.getElementById('loginOverlay')?.classList.add('hidden');
