    <script>
        // --- CLOUD CONFIG CONSTANTS ---
        const DEFAULT_CLOUD_SCRIPT_URL = "https://script.google.com/macros/s/AKfycbx8M3O2j1y-TUVp5iNjt5dJsDgr2DS5AUlu5xb2zXvGfgbid9x8dEeZnAbRQjh_jt7Z/exec";
        const DEFAULT_CLOUD_SECRET_TOKEN = "TAMALAND-SEC-2026";

        function getCloudConfig() {
            const urlInput = document.getElementById('cloudScriptUrl');
            const tokenInput = document.getElementById('cloudSecretTokenInput');

            const rawUrl = (urlInput && urlInput.value.trim()) ||
                (state.identitas && state.identitas.cloudScriptUrl) ||
                localStorage.getItem('tamaland_gas_url') ||
                DEFAULT_CLOUD_SCRIPT_URL;

            const rawToken = (tokenInput && tokenInput.value.trim()) ||
                (state.identitas && state.identitas.cloudSecretToken) ||
                localStorage.getItem('tamaland_gas_token') ||
                DEFAULT_CLOUD_SECRET_TOKEN;

            const cleanUrl = String(rawUrl || '').trim();
            const cleanToken = String(rawToken || '').trim() || DEFAULT_CLOUD_SECRET_TOKEN;
            const isValidHttps = /^https:\/\/script\.google\.com\/macros\/s\/[a-zA-Z0-9_-]+\/exec/i.test(cleanUrl);

            return {
                url: cleanUrl,
                token: cleanToken,
                isValidHttps
            };
        }

        function updateCloudConfigSummaryBadge() {
            const cfg = getCloudConfig();
            const badgeEl = document.getElementById('cloudConfigStatusSummary');
            if (!badgeEl) return;

            if (!cfg.url) {
                badgeEl.innerText = 'URL Cloud Belum Diatur';
                badgeEl.className = 'text-[10px] font-mono px-2.5 py-1 rounded-lg bg-rose-50 text-rose-700 border border-rose-200';
                return;
            }
            const maskedToken = cfg.token.length > 6
                ? `${cfg.token.slice(0, 4)}•••${cfg.token.slice(-4)}`
                : '••••••';
            badgeEl.innerText = `${cfg.isValidHttps ? 'GAS Web App Aktif' : 'URL Kustom'} • Token: ${maskedToken}`;
            badgeEl.className = 'text-[10px] font-mono px-2.5 py-1 rounded-lg bg-slate-100 text-slate-700 border border-slate-200';
        }

        function toggleCloudTokenVisibility() {
            const tokenInput = document.getElementById('cloudSecretTokenInput');
            if (!tokenInput) return;
            tokenInput.type = tokenInput.type === 'password' ? 'text' : 'password';
        }

        function resetDefaultCloudConfig() {
            if (document.getElementById('cloudScriptUrl')) {
                document.getElementById('cloudScriptUrl').value = DEFAULT_CLOUD_SCRIPT_URL;
            }
            if (document.getElementById('cloudSecretTokenInput')) {
                document.getElementById('cloudSecretTokenInput').value = DEFAULT_CLOUD_SECRET_TOKEN;
            }
            saveCloudSetup();
        }

        function testCloudConnection() {
            const cfg = getCloudConfig();
            if (!cfg.url) {
                Swal.fire({ icon: 'warning', title: 'URL Kosong', text: 'Masukkan Google Apps Script Web App URL terlebih dahulu.' });
                return;
            }
            showLoadingOverlay('Menguji Koneksi Cloud...', 'Memeriksa akses Web App & Secret Token...');
            const testUrl = cfg.url + (cfg.url.includes('?') ? '&' : '?') + 'token=' + encodeURIComponent(cfg.token);

            fetchWithTimeout(testUrl, {}, 12000)
                .then(res => res.json())
                .then(res => {
                    hideLoadingOverlay();
                    if (res && res.status === 'unauthorized') {
                        Swal.fire({ icon: 'error', title: 'Token Tidak Valid (401)', text: res.message || 'Secret Token tidak cocok dengan konfigurasi Apps Script.' });
                        return;
                    }
                    if (res && res.status === 'success') {
                        Swal.fire({
                            icon: 'success',
                            title: 'Koneksi Cloud Terhubung',
                            text: `Token tervalidasi • Zona Waktu: ${res.timezone || 'Asia/Jakarta'} (${res.timestampWIB || 'WIB'})`
                        });
                    } else {
                        Swal.fire({ icon: 'warning', title: 'Respons Tidak Diharapkan', text: 'Endpoint merespons namun status tidak sukses.' });
                    }
                })
                .catch(() => {
                    hideLoadingOverlay();
                    Swal.fire({ icon: 'error', title: 'Uji Koneksi Gagal', text: 'Pastikan URL Web App valid, di-deploy sebagai Web App (Anyone), dan jaringan aktif.' });
                });
        }

        // --- XSS SANITIZATION HELPER ---
        function escapeHTML(str) {
            if (str === null || str === undefined) return '';
            return String(str)
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;')
                .replace(/'/g, '&#39;');
        }

        // Cegah skema URI berbahaya (javascript:, vbscript:, data: non-gambar)
        function sanitizeSafeImageURL(url, fallback = 'https://placehold.co/80x80/0284c7/ffffff?text=TAMALAND') {
            if (!url || typeof url !== 'string') return fallback;
            const trimmed = url.trim();
            if (/^https?:\/\//i.test(trimmed)) return trimmed;
            if (/^data:image\/(jpeg|jpg|png|webp);base64,[a-zA-Z0-9+/=]+$/i.test(trimmed)) return trimmed;
            return fallback;
        }

        function sanitizeSafeExternalURL(url) {
            if (!url || typeof url !== 'string') return '';
            const trimmed = url.trim();
            if (/^https:\/\//i.test(trimmed)) return trimmed;
            return '';
        }

        // --- BRUTE-FORCE / RATE LIMIT PROTECTION ---
        const loginAttemptTracker = {
            failures: {},
            maxAttempts: 5,
            lockoutMs: 60000
        };

        function checkLoginRateLimit(key) {
            const cleanKey = String(key || 'default').toLowerCase();
            const rec = loginAttemptTracker.failures[cleanKey];
            if (!rec) return { locked: false };
            const now = Date.now();
            if (rec.lockedUntil && now < rec.lockedUntil) {
                const sisaDetik = Math.ceil((rec.lockedUntil - now) / 1000);
                return { locked: true, secondsLeft: sisaDetik };
            }
            if (rec.lockedUntil && now >= rec.lockedUntil) {
                delete loginAttemptTracker.failures[cleanKey];
            }
            return { locked: false };
        }

        function recordFailedLoginAttempt(key) {
            const cleanKey = String(key || 'default').toLowerCase();
            const now = Date.now();
            const rec = loginAttemptTracker.failures[cleanKey] || { count: 0, lockedUntil: 0 };
            rec.count += 1;
            if (rec.count >= loginAttemptTracker.maxAttempts) {
                rec.lockedUntil = now + loginAttemptTracker.lockoutMs;
                rec.count = 0;
            }
            loginAttemptTracker.failures[cleanKey] = rec;
        }

        function resetLoginAttempts(key) {
            const cleanKey = String(key || 'default').toLowerCase();
            delete loginAttemptTracker.failures[cleanKey];
        }

        // --- JAKARTA TIMEZONE HELPERS (Asia/Jakarta / WIB) ---
        function getJakartaDateParts(dateObj = new Date()) {
            try {
                const formatter = new Intl.DateTimeFormat('en-CA', {
                    timeZone: 'Asia/Jakarta',
                    year: 'numeric',
                    month: '2-digit',
                    day: '2-digit',
                    hour: '2-digit',
                    minute: '2-digit',
                    second: '2-digit',
                    hour12: false
                });
                const parts = formatter.formatToParts(dateObj);
                const map = {};
                parts.forEach(p => { map[p.type] = p.value; });
                return {
                    year: map.year || '2026',
                    month: map.month || '01',
                    day: map.day || '01',
                    hour: map.hour || '00',
                    minute: map.minute || '00',
                    second: map.second || '00'
                };
            } catch (e) {
                const wib = new Date(dateObj.getTime() + (7 * 60 * 60 * 1000));
                return {
                    year: String(wib.getUTCFullYear()),
                    month: String(wib.getUTCMonth() + 1).padStart(2, '0'),
                    day: String(wib.getUTCDate()).padStart(2, '0'),
                    hour: String(wib.getUTCHours()).padStart(2, '0'),
                    minute: String(wib.getUTCMinutes()).padStart(2, '0'),
                    second: String(wib.getUTCSeconds()).padStart(2, '0')
                };
            }
        }

        function getTodayJakartaISO() {
            const p = getJakartaDateParts(new Date());
            return `${p.year}-${p.month}-${p.day}`;
        }

        function formatJakartaFullTimestamp(dateObj = new Date()) {
            const p = getJakartaDateParts(dateObj);
            return `${p.year}-${p.month}-${p.day} ${p.hour}:${p.minute}:${p.second} WIB`;
        }

        function formatJakartaDisplayDateID(dateStrOrObj = new Date()) {
            const d = typeof dateStrOrObj === 'string' && /^\d{4}-\d{2}-\d{2}$/.test(dateStrOrObj.trim())
                ? new Date(dateStrOrObj.trim() + 'T12:00:00+07:00')
                : new Date(dateStrOrObj);
            if (isNaN(d.getTime())) return getTodayJakartaISO();
            try {
                return new Intl.DateTimeFormat('id-ID', {
                    timeZone: 'Asia/Jakarta',
                    weekday: 'short',
                    day: '2-digit',
                    month: 'short',
                    year: 'numeric'
                }).format(d) + ' WIB';
            } catch (e) {
                return getTodayJakartaISO() + ' WIB';
            }
        }

        function updateJakartaTimezoneUI() {
            const p = getJakartaDateParts(new Date());
            const clockStr = `${p.hour}:${p.minute}:${p.second} WIB`;
            const dateStr = `${p.year}-${p.month}-${p.day}`;

            const loginTzEl = document.getElementById('loginJakartaTimezoneBadge');
            if (loginTzEl) {
                loginTzEl.innerText = `${dateStr} ${clockStr}`;
            }

            const headerTzEl = document.getElementById('headerJakartaClockBadge');
            if (headerTzEl) {
                headerTzEl.innerText = ` ${p.hour}:${p.minute}`;
            }

            const setupTzEl = document.getElementById('setupJakartaTimezoneInfo');
            if (setupTzEl) {
                setupTzEl.innerText = `Zona Waktu Aktif: Asia/Jakarta (WIB / GMT+7) — Waktu Sistem: ${dateStr} ${clockStr}`;
            }
        }

        function startJakartaLiveClock() {
            updateJakartaTimezoneUI();
            if (window.__jakartaClockInterval) {
                clearInterval(window.__jakartaClockInterval);
            }
            window.__jakartaClockInterval = setInterval(updateJakartaTimezoneUI, 1000);
        }

        // --- SECURITY HARDENING HELPERS ---
        async function hashPasswordSHA256(plainText) {
            if (!plainText) return '';
            const str = String(plainText).trim();
            if (str.startsWith('sha256:')) return str;
            try {
                if (typeof window !== 'undefined' && window.crypto && window.crypto.subtle && typeof TextEncoder !== 'undefined') {
                    const msgBuffer = new TextEncoder().encode('SIWARTA_SALT_' + str);
                    const hashBuffer = await window.crypto.subtle.digest('SHA-256', msgBuffer);
                    const hashArray = Array.from(new Uint8Array(hashBuffer));
                    const hashHex = hashArray.map(b => b.toString(16).padStart(2, '0')).join('');
                    return 'sha256:' + hashHex;
                }
            } catch (err) {
                console.warn('Web Crypto API unavailable:', err);
            }
            return 'sha256:' + btoa(str).split('').reverse().join('');
        }

        async function verifyPassword(inputPlain, storedPass) {
            if (!storedPass) return false;
            const cleanInput = String(inputPlain || '').trim();
            const cleanStored = String(storedPass || '').trim();
            if (!cleanInput) return false;
            if (cleanStored.startsWith('sha256:')) {
                const hashedInput = await hashPasswordSHA256(cleanInput);
                return hashedInput === cleanStored;
            }
            return cleanInput === cleanStored;
        }

        function validateImageFile(file, maxSizeMB = 5) {
            if (!file) return { valid: false, message: 'Tidak ada file yang dipilih.' };
            const allowedTypes = ['image/jpeg', 'image/jpg', 'image/png'];
            if (!allowedTypes.includes(file.type)) {
                return {
                    valid: false,
                    message: 'Format file ditolak! Hanya file gambar JPG, JPEG, atau PNG yang diperbolehkan demi keamanan sistem.'
                };
            }
            const maxBytes = maxSizeMB * 1024 * 1024;
            if (file.size > maxBytes) {
                return {
                    valid: false,
                    message: `Ukuran file terlalu besar (${(file.size / (1024 * 1024)).toFixed(2)} MB). Maksimal ${maxSizeMB} MB.`
                };
            }
            return { valid: true };
        }

        function formatRupiah(number) {
            if (isNaN(number) || number === null) return 'Rp 0';
            return 'Rp ' + Number(number).toLocaleString('id-ID');
        }

        function generateUniqueId(prefix = 'ID') {
            return prefix + '-' + Math.floor(100000 + Math.random() * 900000);
        }

        function formatCleanDate(val) {
            if (!val) return getTodayJakartaISO();
            const str = String(val).trim();
            if (/^\d{4}-\d{2}-\d{2}/.test(str)) return str.slice(0, 10);
            const parsed = new Date(str);
            if (!isNaN(parsed.getTime())) {
                const p = getJakartaDateParts(parsed);
                return `${p.year}-${p.month}-${p.day}`;
            }
            return escapeHTML(str);
        }

        function formatPeriodeBulan(val) {
            if (!val) return '';
            const str = String(val).trim();
            const bulanNames = ['Januari', 'Februari', 'Maret', 'April', 'Mei', 'Juni', 'Juli', 'Agustus', 'September', 'Oktober', 'November', 'Desember'];
            const shortBulanMap = {
                jan: 0, feb: 1, mar: 2, apr: 3, mei: 4, may: 4,
                jun: 5, jul: 6, agu: 7, aug: 7, sep: 8, okt: 9, oct: 9, nov: 10, des: 11, dec: 11
            };

            const lowerStr = str.toLowerCase();
            const matchedBulanIdx = bulanNames.findIndex(b => lowerStr.includes(b.toLowerCase()));
            if (matchedBulanIdx !== -1) {
                const yearMatch = str.match(/\b(20\d{2})\b/);
                return `${bulanNames[matchedBulanIdx]} ${yearMatch ? yearMatch[1] : '2026'}`;
            }

            const shortMatch = lowerStr.match(/\b(jan|feb|mar|apr|mei|may|jun|jul|agu|aug|sep|okt|oct|nov|des|dec)\b[\s\-/]*(20\d{2})?/);
            if (shortMatch) {
                const mIdx = shortBulanMap[shortMatch[1]];
                if (mIdx !== undefined) {
                    return `${bulanNames[mIdx]} ${shortMatch[2] || '2026'}`;
                }
            }

            const isoYearMonthMatch = str.match(/^(\d{4})[-/](\d{1,2})(?:[-/](\d{1,2}))?/);
            if (isoYearMonthMatch) {
                const yearStr = isoYearMonthMatch[1];
                const mIdx = parseInt(isoYearMonthMatch[2], 10) - 1;
                if (mIdx >= 0 && mIdx < 12) {
                    return `${bulanNames[mIdx]} ${yearStr}`;
                }
            }

            const dmyMatch = str.match(/^(\d{1,2})[-/](\d{1,2})[-/](\d{4})/);
            if (dmyMatch) {
                const yearStr = dmyMatch[3];
                const mIdx = parseInt(dmyMatch[2], 10) - 1;
                if (mIdx >= 0 && mIdx < 12) {
                    return `${bulanNames[mIdx]} ${yearStr}`;
                }
            }

            const parsed = new Date(str);
            if (!isNaN(parsed.getTime())) {
                const p = getJakartaDateParts(parsed);
                const mIdx = parseInt(p.month, 10) - 1;
                if (mIdx >= 0 && mIdx < 12) {
                    return `${bulanNames[mIdx]} ${p.year}`;
                }
            }

            return escapeHTML(str);
        }

        function formatPeriodeFromDateISO(dateStr) {
            const bulanNames = ['Januari', 'Februari', 'Maret', 'April', 'Mei', 'Juni', 'Juli', 'Agustus', 'September', 'Oktober', 'November', 'Desember'];
            const cleanDate = formatCleanDate(dateStr || getTodayJakartaISO());
            const parts = cleanDate.split('-');
            if (parts.length === 3) {
                const yearStr = parts[0];
                const mIdx = parseInt(parts[1], 10) - 1;
                if (mIdx >= 0 && mIdx < 12) {
                    return `${bulanNames[mIdx]} ${yearStr}`;
                }
            }
            return formatPeriodeBulan(dateStr || getTodayJakartaISO());
        }

        function syncPeriodeWithTanggalBayarAdmin() {
            const tglVal = document.getElementById('bayarAdminTanggalInput')?.value;
            const periodeSelect = document.getElementById('bayarAdminPeriodeSelect');
            if (!tglVal || !periodeSelect) return;

            const derivedPeriode = formatPeriodeFromDateISO(tglVal);
            let matchedOption = Array.from(periodeSelect.options).find(opt => opt.value === derivedPeriode);
            if (!matchedOption) {
                matchedOption = document.createElement('option');
                matchedOption.value = derivedPeriode;
                matchedOption.textContent = derivedPeriode;
                periodeSelect.appendChild(matchedOption);
            }
            periodeSelect.value = derivedPeriode;
        }

        function normalizeAndSortWargaList() {
            if (!Array.isArray(state.wargaList)) state.wargaList = [];
            state.wargaList.sort((a, b) => String(a.noRumah || '').localeCompare(String(b.noRumah || ''), undefined, { numeric: true, sensitivity: 'base' }));
        }

        function deduplicateAllCollectionsById() {
            const dedup = (arr, keyFn) => {
                if (!Array.isArray(arr)) return [];
                const map = new Map();
                arr.forEach(item => {
                    if (item) {
                        const k = keyFn(item);
                        if (k) map.set(k, item);
                    }
                });
                return Array.from(map.values());
            };
            state.wargaList = dedup(state.wargaList, w => String(w.noRumah || w.id || '').trim().toUpperCase());
            normalizeAndSortWargaList();
            state.calonWargaList = dedup(state.calonWargaList, c => String(c.noRumah || c.id || '').trim().toUpperCase());
            state.iuranList = dedup(state.iuranList, i => String(i.id || i.nama || '').trim());
            state.transaksiList = dedup(state.transaksiList, t => String(t.id || '').trim());
            state.pengeluaranList = dedup(state.pengeluaranList, p => String(p.id || '').trim());
            state.pengurusList = dedup(state.pengurusList, pr => String(pr.id || pr.username || '').trim());
            state.ratingList = dedup(state.ratingList, r => String(r.id || '').trim());
            state.meterAirList = dedup(state.meterAirList, m => String(m.id || `${m.noRumah}_${m.periode}`).trim());
            state.accessLogList = dedup(state.accessLogList, l => String(l.id || '').trim());
            state.pesanList = dedup(state.pesanList, ps => String(ps.id || '').trim());
        }

