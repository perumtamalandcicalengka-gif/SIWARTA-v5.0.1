        function handleRestoreBackupFile(inputElem) {
            if (inputElem && inputElem.files && inputElem.files[0]) {
                const file = inputElem.files[0];
                const fileNameLower = String(file.name || '').toLowerCase();

                const finalizeRestore = () => {
                    deduplicateAllCollectionsById();
                    saveToLocalStorage();
                    renderIdentitasVisuals();
                    renderCalonWargaQueue();
                    updateHeaderStats();
                    renderTableWarga();
                    renderCardsIuranList();
                    renderSkemaKategoriCards();
                    renderTableTransaksi();
                    renderMatriksTunggakan();
                    renderTableMeterAir();
                    renderTableBayarAir();
                    renderTablePengeluaran();
                    renderLaporanKas();
                    renderPesanAdminSection();
                    renderPengurusCards();
                    renderTableRatingAdmin();
                    renderTableAccessLog();
                    renderRolePermissionsSummary();
                    populateJalanFilter();
                    if (inputElem) inputElem.value = '';
                    Swal.fire({ icon: 'success', title: 'Restore Berhasil', text: `Data dari file ${escapeHTML(file.name)} berhasil dipulihkan!`, timer: 1500, showConfirmButton: false });
                };

                if (fileNameLower.endsWith('.json')) {
                    const reader = new FileReader();
                    reader.onload = function(e) {
                        try {
                            const parsed = JSON.parse(e.target.result);
                            if (parsed.wargaList) state.wargaList = parsed.wargaList;
                            if (parsed.calonWargaList) state.calonWargaList = parsed.calonWargaList;
                            if (parsed.iuranList) state.iuranList = parsed.iuranList;
                            if (parsed.transaksiList) state.transaksiList = parsed.transaksiList;
                            if (parsed.pengeluaranList) state.pengeluaranList = parsed.pengeluaranList;
                            if (parsed.pengurusList) state.pengurusList = parsed.pengurusList;
                            if (parsed.ratingList) state.ratingList = parsed.ratingList;
                            if (parsed.meterAirList) state.meterAirList = parsed.meterAirList;
                            if (parsed.accessLogList) state.accessLogList = parsed.accessLogList;
                            if (parsed.pesanList) state.pesanList = parsed.pesanList;
                            if (parsed.identitas) state.identitas = { ...state.identitas, ...parsed.identitas };
                            if (parsed.kategoriRates) state.kategoriRates = { ...state.kategoriRates, ...parsed.kategoriRates };
                            if (parsed.rolePermissions) state.rolePermissions = { ...state.rolePermissions, ...parsed.rolePermissions };
                            finalizeRestore();
                        } catch (err) {
                            if (inputElem) inputElem.value = '';
                            Swal.fire({ icon: 'error', title: 'Format File Salah', text: 'Gagal memparsing file JSON.' });
                        }
                    };
                    reader.readAsText(file);
                } else if (fileNameLower.endsWith('.xlsx') || fileNameLower.endsWith('.xls')) {
                    if (typeof XLSX === 'undefined') {
                        if (inputElem) inputElem.value = '';
                        Swal.fire({ icon: 'error', title: 'Library Excel Belum Siap', text: 'SheetJS belum termuat untuk membaca file .xlsx.' });
                        return;
                    }
                    const reader = new FileReader();
                    reader.onload = function(e) {
                        try {
                            const data = new Uint8Array(e.target.result);
                            const workbook = XLSX.read(data, { type: 'array' });

                            const getSheetRows = (sheetName) => {
                                const ws = workbook.Sheets[sheetName];
                                if (!ws) return [];
                                const aoa = XLSX.utils.sheet_to_json(ws, { header: 1, defval: '' });
                                return Array.isArray(aoa) && aoa.length > 1 ? aoa.slice(1) : [];
                            };

                            const identitasRows = getSheetRows('Identitas');
                            if (identitasRows.length > 0) {
                                identitasRows.forEach(r => {
                                    const k = String(r[0] || '').trim();
                                    const v = String(r[1] || '').trim();
                                    if (k === 'Nama Perumahan' && v) state.identitas.namaPerumahan = v;
                                    if (k === 'Alamat' && v) state.identitas.alamat = v;
                                    if (k === 'Logo URL' && v) state.identitas.logoUrl = v;
                                    if (k === 'TTD Bendahara URL' && v) state.identitas.ttdBendaharaUrl = v;
                                    if (k === 'No Rekening' && v) state.identitas.noRekening = v;
                                    if (k === 'QRIS URL' && v) state.identitas.qrisUrl = v;
                                    if (k === 'Visual Theme' && v) state.identitas.theme = v;
