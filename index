        function downloadWargaPDF() {
            if (typeof window.jspdf === 'undefined') {
                Swal.fire({ icon: 'error', title: 'Library PDF Belum Siap', text: 'jsPDF belum termuat.' });
                return;
            }
            const { jsPDF } = window.jspdf;
            const doc = new jsPDF('p', 'mm', 'a4');
            const pageWidth = doc.internal.pageSize.getWidth();
            let currentY = 15;

            const logoUrl = state.identitas?.logoUrl || '';
            if (logoUrl) {
                try {
                    doc.addImage(logoUrl, 'JPEG', 14, currentY, 14, 14);
                } catch (e) {}
            }

            doc.setFontSize(14);
            doc.setFont("helvetica", "bold");
            doc.text((state.identitas?.namaPerumahan || 'PERUMAHAN TAMALAND').toUpperCase(), logoUrl ? 32 : 14, currentY + 6);
            
            doc.setFontSize(9);
            doc.setFont("helvetica", "normal");
            doc.text("LAPORAN DATA WARGA", logoUrl ? 32 : 14, currentY + 11);
            doc.text("Alamat: " + (state.identitas?.alamat || '-'), logoUrl ? 32 : 14, currentY + 15);

            currentY += 22;
            doc.setDrawColor(200, 200, 200);
            doc.line(14, currentY, pageWidth - 14, currentY);
            currentY += 6;
            
            const rows = (state.wargaList || []).map((w, idx) => [idx + 1, w.noRumah, w.nama, w.jalan, w.anggota + ' Jiwa', w.wa, w.kategori, w.statusHunian]);
            doc.autoTable({
                head: [['No', 'Blok', 'Nama Warga', 'Jalan', 'Anggota', 'WhatsApp', 'Kategori', 'Status']],
                body: rows,
                startY: currentY,
                theme: 'grid',
                styles: { fontSize: 8 },
                headStyles: { fillColor: [2, 132, 199], textColor: [255, 255, 255], fontStyle: 'bold' }
            });
            doc.save('Data_Warga_Tamaland.pdf');
        }

