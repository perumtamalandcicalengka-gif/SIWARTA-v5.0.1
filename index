        function renderMatriksTunggakan(resetPage = true) {
            if (resetPage) paginationState.matriks = 1;
            const tbody = document.getElementById('tblMatriksBody');
            if (!tbody) return;
            tbody.innerHTML = '';

            const tahun = document.getElementById('matriksFilterTahun')?.value || '2026';
            const search = (document.getElementById('searchMatriksInput')?.value || '').toLowerCase();
            const jenisIuranFilter = document.getElementById('matriksFilterJenisIuran')?.value || 'IURAN WAJIB';
            const listBulan = ['01', '02', '03', '04', '05', '06', '07', '08', '09', '10', '11', '12'];
            const namaBulanLabel = ['JAN', 'FEB', 'MAR', 'APR', 'MEI', 'JUN', 'JUL', 'AGU', 'SEP', 'OKT', 'NOV', 'DES'];

            let totalTarifDasar = 0;
            (state.iuranList || []).forEach(i => {
                if (i.wajib) totalTarifDasar += Number(i.nominal) || 0;
            });
            if (totalTarifDasar === 0) totalTarifDasar = 50000;

            const filteredWarga = (state.wargaList || []).filter(w => {
                const text = `${w.noRumah} ${w.nama}`.toLowerCase();
                return text.includes(search);
            });

            const grandTotalTahunFoot = document.getElementById('matriksGrandTotalTahun');
            if (filteredWarga.length === 0) {
                tbody.innerHTML = `<tr><td colspan="15" class="p-6 text-center text-slate-400">Belum ada data warga untuk ditampilkan di matriks tunggakan.</td></tr>`;
                if (grandTotalTahunFoot) grandTotalTahunFoot.innerText = formatRupiah(0);
                renderPaginationControls('paginationMatriks', 'matriks', 0);
                return;
            }

            let totalTunggakanSetahunSemuaWarga = 0;
            filteredWarga.forEach(w => {
                const isSubsidi = (w.kategori || '').toLowerCase().includes('subsidi') || (w.kategori || '').toLowerCase().includes('bebas');
                listBulan.forEach((bNum, idx) => {
                    const yyyymm = `${tahun}-${bNum}`;
                    let tagihanBulanIni = totalTarifDasar;
                    if (jenisIuranFilter === 'TAGIHAN AIR') {
                        const waterRec = (state.meterAirList || []).find(m => {
                            const matchBlok = String(m.noRumah || '').trim().toUpperCase() === String(w.noRumah || '').trim().toUpperCase();
                            const mPeriode = formatPeriodeBulan(m.periode || '').toLowerCase();
                            return matchBlok && (mPeriode.includes(namaBulanLabel[idx].toLowerCase()) || String(m.periode).includes(yyyymm));
                        });
                        tagihanBulanIni = waterRec ? (Number(waterRec.totalTagihan) || 0) : 0;
                    } else {
                        let pengali = 1;
                        const kat = (w.kategori || '').toLowerCase();
                        if (kat.includes('diskon')) pengali = 0.5;
                        else if (isSubsidi) pengali = 0;
                        tagihanBulanIni = totalTarifDasar * pengali;
                    }

                    const matchedTrx = (state.transaksiList || []).find(t => {
                        const matchBlok = String(t.noRumah || '').trim().toUpperCase() === String(w.noRumah || '').trim().toUpperCase();
                        const isApproved = t.metode !== 'Transfer Mandiri' || t.validasiAdmin === 'Disetujui';
                        const isAirTrx = t.categoryId === 'air' || t.metode === 'Tagihan Air' || (t.metode || '').toLowerCase().includes('air');
                        if (jenisIuranFilter === 'TAGIHAN AIR' && !isAirTrx) return false;
                        if (jenisIuranFilter === 'IURAN WAJIB' && isAirTrx) return false;
                        const tBulan = formatPeriodeBulan(t.bulan || '').toLowerCase();
                        const matchBulan = (tBulan.includes(namaBulanLabel[idx].toLowerCase()) && tBulan.includes(tahun)) || String(t.bulan || '').includes(yyyymm);
                        return matchBlok && isApproved && matchBulan;
                    });

                    const pendingAirTrx = (state.transaksiList || []).find(t => {
                        const matchBlok = String(t.noRumah || '').trim().toUpperCase() === String(w.noRumah || '').trim().toUpperCase();
                        const isAirTrx = t.categoryId === 'air' || t.metode === 'Tagihan Air' || (t.metode || '').toLowerCase().includes('air');
                        if (!isAirTrx || jenisIuranFilter !== 'TAGIHAN AIR') return false;
                        const tBulan = formatPeriodeBulan(t.bulan || '').toLowerCase();
                        const matchBulan = (tBulan.includes(namaBulanLabel[idx].toLowerCase()) && tBulan.includes(tahun)) || String(t.bulan || '').includes(yyyymm);
                        return matchBlok && matchBulan && (t.statusBayar === 'Belum Lunas' || t.statusBayar === 'Pending' || t.validasiAdmin === 'Menunggu Validasi');
                    });

                    if (pendingAirTrx && jenisIuranFilter === 'TAGIHAN AIR') {
                        totalTunggakanSetahunSemuaWarga += Number(pendingAirTrx.nominal) || tagihanBulanIni;
                    } else if (matchedTrx) {
                        const nominalTrx = Number(matchedTrx.nominal) || 0;
                        if (nominalTrx < tagihanBulanIni || matchedTrx.statusBayar === 'Kurang Bayar' || matchedTrx.statusBayar === 'Belum Lunas' || matchedTrx.statusBayar === 'Belum Lunas / Kurang Bayar') {
                            totalTunggakanSetahunSemuaWarga += matchedTrx.kekurangan || (tagihanBulanIni - nominalTrx);
                        }
                    } else if (!(jenisIuranFilter === 'IURAN WAJIB' && isSubsidi) && !(tagihanBulanIni === 0 && jenisIuranFilter === 'TAGIHAN AIR')) {
                        totalTunggakanSetahunSemuaWarga += tagihanBulanIni;
                    }
                });
            });
            if (grandTotalTahunFoot) grandTotalTahunFoot.innerText = formatRupiah(totalTunggakanSetahunSemuaWarga);

            const totalPages = Math.max(1, Math.ceil(filteredWarga.length / PAGE_SIZE));
            if (paginationState.matriks > totalPages) paginationState.matriks = totalPages;
            const startIndex = (paginationState.matriks - 1) * PAGE_SIZE;
            const pageWarga = filteredWarga.slice(startIndex, startIndex + PAGE_SIZE);

            pageWarga.forEach(w => {
                const tr = document.createElement('tr');
                let rowHtml = `
                    <td class="p-3.5 border-r font-bold text-brand-700 text-center">${escapeHTML(w.noRumah)}</td>
                    <td class="p-3.5 border-r font-semibold text-slate-800">${escapeHTML(w.nama)}</td>
                `;

                let totalTunggakanNominal = 0;
                let bulanMenunggakCount = 0;
                const isSubsidi = (w.kategori || '').toLowerCase().includes('subsidi') || (w.kategori || '').toLowerCase().includes('bebas');

                listBulan.forEach((bNum, idx) => {
                    const yyyymm = `${tahun}-${bNum}`;

                    let tagihanBulanIni = totalTarifDasar;
                    if (jenisIuranFilter === 'TAGIHAN AIR') {
                        const waterRec = (state.meterAirList || []).find(m => {
                            const matchBlok = String(m.noRumah || '').trim().toUpperCase() === String(w.noRumah || '').trim().toUpperCase();
                            const mPeriode = formatPeriodeBulan(m.periode || '').toLowerCase();
                            return matchBlok && (mPeriode.includes(namaBulanLabel[idx].toLowerCase()) || String(m.periode).includes(yyyymm));
                        });
                        tagihanBulanIni = waterRec ? (Number(waterRec.totalTagihan) || 0) : 0;
                    } else {
                        let pengali = 1;
                        const kat = (w.kategori || '').toLowerCase();
                        if (kat.includes('diskon')) pengali = 0.5;
                        else if (isSubsidi) pengali = 0;
                        tagihanBulanIni = totalTarifDasar * pengali;
                    }

                    const matchedTrx = (state.transaksiList || []).find(t => {
                        const matchBlok = String(t.noRumah || '').trim().toUpperCase() === String(w.noRumah || '').trim().toUpperCase();
                        const isApproved = t.metode !== 'Transfer Mandiri' || t.validasiAdmin === 'Disetujui';
                        const isAirTrx = t.categoryId === 'air' || t.metode === 'Tagihan Air' || (t.metode || '').toLowerCase().includes('air');
                        
                        if (jenisIuranFilter === 'TAGIHAN AIR' && !isAirTrx) return false;
                        if (jenisIuranFilter === 'IURAN WAJIB' && isAirTrx) return false;

                        const tBulan = formatPeriodeBulan(t.bulan || '').toLowerCase();
                        const matchBulan = (tBulan.includes(namaBulanLabel[idx].toLowerCase()) && tBulan.includes(tahun)) || String(t.bulan || '').includes(yyyymm);
                        return matchBlok && isApproved && matchBulan;
                    });

                    const pendingAirTrx = (state.transaksiList || []).find(t => {
                        const matchBlok = String(t.noRumah || '').trim().toUpperCase() === String(w.noRumah || '').trim().toUpperCase();
                        const isAirTrx = t.categoryId === 'air' || t.metode === 'Tagihan Air' || (t.metode || '').toLowerCase().includes('air');
                        if (!isAirTrx || jenisIuranFilter !== 'TAGIHAN AIR') return false;
                        const tBulan = formatPeriodeBulan(t.bulan || '').toLowerCase();
                        const matchBulan = (tBulan.includes(namaBulanLabel[idx].toLowerCase()) && tBulan.includes(tahun)) || String(t.bulan || '').includes(yyyymm);
                        return matchBlok && matchBulan && (t.statusBayar === 'Belum Lunas' || t.statusBayar === 'Pending' || t.validasiAdmin === 'Menunggu Validasi');
                    });

                    let cellBadge = `<span class="px-1.5 py-0.5 bg-rose-100 text-rose-700 font-bold rounded text-[10px]" title="Belum Bayar">X</span>`;

                    if (pendingAirTrx && jenisIuranFilter === 'TAGIHAN AIR') {
                        cellBadge = `<span class="px-1.5 py-0.5 bg-amber-100 text-amber-800 font-bold rounded text-[10px]" title="Tagihan Air Belum Lunas / Pending">BL</span>`;
                        totalTunggakanNominal += Number(pendingAirTrx.nominal) || tagihanBulanIni;
                        bulanMenunggakCount++;
                    } else if (matchedTrx) {
                        const nominalTrx = Number(matchedTrx.nominal) || 0;
                        if (nominalTrx < tagihanBulanIni || matchedTrx.statusBayar === 'Kurang Bayar' || matchedTrx.statusBayar === 'Belum Lunas' || matchedTrx.statusBayar === 'Belum Lunas / Kurang Bayar') {
                            cellBadge = `<span class="px-1.5 py-0.5 bg-amber-100 text-amber-800 font-bold rounded text-[10px]" title="Kurang Bayar / Belum Lunas">BL</span>`;
                            totalTunggakanNominal += matchedTrx.kekurangan || (tagihanBulanIni - nominalTrx);
                            bulanMenunggakCount++;
                        } else {
                            matchedTrx.statusBayar = 'Lunas';
                            matchedTrx.kekurangan = 0;
                            cellBadge = `<span class="px-1.5 py-0.5 bg-purple-100 text-purple-800 font-bold rounded text-[10px]" title="Lunas">L</span>`;
                        }
                    } else if (jenisIuranFilter === 'IURAN WAJIB' && isSubsidi) {
                        cellBadge = `<span class="px-1.5 py-0.5 bg-emerald-100 text-emerald-800 font-bold rounded text-[10px]" title="Subsidi">Sub</span>`;
                    } else if (tagihanBulanIni === 0 && jenisIuranFilter === 'TAGIHAN AIR') {
                        cellBadge = `<span class="px-1.5 py-0.5 bg-slate-100 text-slate-500 font-bold rounded text-[10px]" title="Belum Ada Catatan Meter">-</span>`;
                    } else {
                        totalTunggakanNominal += tagihanBulanIni;
                        bulanMenunggakCount++;
                    }

                    rowHtml += `<td class="p-2 border-r text-center">${cellBadge}</td>`;
                });

                rowHtml += `
                    <td class="p-3.5 text-center whitespace-nowrap">
                        <div class="font-extrabold text-rose-600">${formatRupiah(totalTunggakanNominal)}</div>
                        <div class="text-[9px] text-slate-500 font-semibold">1 Tahun (${bulanMenunggakCount}/12 bln)</div>
                    </td>
                `;
                tr.innerHTML = rowHtml;
                tbody.appendChild(tr);
            });
            renderPaginationControls('paginationMatriks', 'matriks', filteredWarga.length);
            if (typeof lucide !== 'undefined' && lucide.createIcons) lucide.createIcons();
        }

        function renderLaporanKas(resetPage = true) {
            if (resetPage) paginationState.laporan = 1;
            const tbody = document.getElementById('tblLaporanLedgerBody');
            if (!tbody) return;
            tbody.innerHTML = '';

            const filterPeriode = (document.getElementById('lapFilterPeriode')?.value || '').toLowerCase();
            const filterJenis = document.getElementById('lapFilterJenis')?.value || '';
            const filterBlok = (document.getElementById('lapFilterBlok')?.value || '').trim().toUpperCase();
            const filterJalan = document.getElementById('lapFilterJalan')?.value || '';

            let ledgerItems = [];
            let totalDebetUmum = 0;
            let totalKreditUmum = 0;
            let totalDebetAir = 0;
            let totalKreditAir = 0;

            if (!filterJenis || filterJenis === 'IURAN WARGA' || filterJenis === 'PEMBAYARAN AIR') {
                (state.transaksiList || []).forEach(t => {
                    const isPending = t.metode === 'Transfer Mandiri' && (t.validasiAdmin === 'Menunggu Validasi' || t.validasiAdmin === 'Pending');
                    const isUnpaidOrPendingBill = t.statusBayar === 'Belum Lunas' || t.validasiAdmin === 'Ditolak';
                    if (isPending || isUnpaidOrPendingBill) return;

                    const isAir = t.categoryId === 'air' || t.metode === 'Tagihan Air';
                    if (filterJenis === 'PEMBAYARAN AIR' && !isAir) return;
                    if (filterJenis === 'IURAN WARGA' && isAir) return;
                    
                    const tglStr = formatCleanDate(t.tanggal);
                    const bulanStr = formatPeriodeBulan(t.bulan || '').toLowerCase();
                    const blokStr = String(t.noRumah || '').toUpperCase();
                    
                    const warga = (state.wargaList || []).find(w => w.noRumah.toUpperCase() === blokStr);
                    const jalanStr = warga ? (warga.jalan || '') : '';

                    const matchPeriode = !filterPeriode || tglStr.includes(filterPeriode) || bulanStr.includes(filterPeriode);
                    const matchBlok = !filterBlok || blokStr.includes(filterBlok);
                    const matchJalan = !filterJalan || jalanStr === filterJalan;

                    if (matchPeriode && matchBlok && matchJalan) {
                        const cashNom = getTransactionCashAmount(t);
                        if (isAir) totalDebetAir += cashNom;
                        else totalDebetUmum += cashNom;

                        ledgerItems.push({
                            tanggal: tglStr,
                            pos: isAir ? 'Pos Air' : 'Pos Umum',
                            jenis: isAir ? 'Pembayaran Air' : 'Iuran Warga',
                            desc: `${isAir ? 'Tagihan Air' : 'Iuran'} ${escapeHTML(t.noRumah)} - ${escapeHTML(t.nama)} (${formatPeriodeBulan(t.bulan || '-')})`,
                            debet: cashNom,
                            kredit: 0
                        });
                    }
                });
            }

            if (!filterJenis || filterJenis === 'PENGELUARAN KAS') {
                (state.pengeluaranList || []).forEach(p => {
                    const tglStr = formatCleanDate(p.tanggal);
                    const matchPeriode = !filterPeriode || tglStr.includes(filterPeriode);
                    const matchBlok = !filterBlok;
                    const matchJalan = !filterJalan;

                    if (matchPeriode && matchBlok && matchJalan) {
                        const katLower = (p.kategori || '').toLowerCase();
                        const descLower = (p.desc || '').toLowerCase();
                        const isPosAir = katLower.includes('pompa') || katLower.includes('air') || katLower.includes('pdam') || katLower.includes('sumur') || descLower.includes('token listrik pompa') || descLower.includes('pompa air') || descLower.includes('mesin air');
                        const nominalExp = Number(p.nominal) || 0;

                        if (isPosAir) totalKreditAir += nominalExp;
                        else totalKreditUmum += nominalExp;

                        ledgerItems.push({
                            tanggal: tglStr,
                            pos: isPosAir ? 'Pos Air' : 'Pos Umum',
                            jenis: `Pengeluaran (${escapeHTML(p.kategori)})`,
                            desc: escapeHTML(p.desc),
                            debet: 0,
                            kredit: nominalExp
                        });
                    }
                });
            }

            ledgerItems.sort((a, b) => new Date(a.tanggal) - new Date(b.tanggal));

            if (ledgerItems.length === 0) {
                tbody.innerHTML = `<tr><td colspan="7" class="p-6 text-center text-slate-400">Tidak ada data transaksi lunas untuk filter laporan yang dipilih.</td></tr>`;
                if (document.getElementById('footSaldoUmum')) document.getElementById('footSaldoUmum').innerText = formatRupiah(0);
                if (document.getElementById('footSaldoAir')) document.getElementById('footSaldoAir').innerText = formatRupiah(0);
                if (document.getElementById('footSaldoBersih')) document.getElementById('footSaldoBersih').innerText = formatRupiah(0);
                renderPaginationControls('paginationLaporan', 'laporan', 0);
                return;
            }

            const totalPages = Math.max(1, Math.ceil(ledgerItems.length / PAGE_SIZE));
            if (paginationState.laporan > totalPages) paginationState.laporan = totalPages;
            const startIndex = (paginationState.laporan - 1) * PAGE_SIZE;
            const pageItems = ledgerItems.slice(startIndex, startIndex + PAGE_SIZE);

            pageItems.forEach((item, idx) => {
                const tr = document.createElement('tr');
                tr.innerHTML = `
                    <td class="p-3.5 text-center text-slate-400 font-mono">${startIndex + idx + 1}</td>
                    <td class="p-3.5 text-slate-600 font-mono">${item.tanggal}</td>
                    <td class="p-3.5"><span class="px-2 py-0.5 rounded text-[9px] font-bold ${item.pos === 'Pos Air' ? 'bg-cyan-100 text-cyan-800' : 'bg-indigo-100 text-indigo-800'}">${item.pos}</span></td>
                    <td class="p-3.5 font-bold text-slate-800">${item.jenis}</td>
                    <td class="p-3.5 text-slate-700">${item.desc}</td>
                    <td class="p-3.5 text-right font-bold text-emerald-600">${item.debet > 0 ? formatRupiah(item.debet) : '-'}</td>
                    <td class="p-3.5 text-right font-bold text-rose-600">${item.kredit > 0 ? formatRupiah(item.kredit) : '-'}</td>
                `;
                tbody.appendChild(tr);
            });

            const saldoUmum = totalDebetUmum - totalKreditUmum;
            const saldoAir = totalDebetAir - totalKreditAir;
            const saldoBersih = saldoUmum + saldoAir;

            if (document.getElementById('footSaldoUmum')) document.getElementById('footSaldoUmum').innerText = formatRupiah(saldoUmum);
            if (document.getElementById('footSaldoAir')) document.getElementById('footSaldoAir').innerText = formatRupiah(saldoAir);
            if (document.getElementById('footSaldoBersih')) document.getElementById('footSaldoBersih').innerText = formatRupiah(saldoBersih);

            renderPaginationControls('paginationLaporan', 'laporan', ledgerItems.length);
            if (typeof lucide !== 'undefined' && lucide.createIcons) lucide.createIcons();
        }

