        function autofillTagihanAirWarga() {
            if (activeBayarAirId) return;
            const noRumah = document.getElementById('bayarAirWargaSelect')?.value;
            const periode = document.getElementById('bayarAirPeriodeSelect')?.value;
            const nomInput = document.getElementById('bayarAirNominalInput');
            if (!noRumah || !nomInput) return;

            const unpaidAir = (state.transaksiList || []).find(t =>
                (t.categoryId === 'air' || t.metode === 'Tagihan Air') &&
                String(t.noRumah || '').trim().toUpperCase() === String(noRumah).trim().toUpperCase() &&
                formatPeriodeBulan(t.bulan || '') === formatPeriodeBulan(periode || '') &&
                t.statusBayar !== 'Lunas'
            );
            if (unpaidAir) {
                nomInput.value = Number(unpaidAir.nominal) || 0;
                return;
            }

            const meterRec = (state.meterAirList || []).find(m =>
                String(m.noRumah || '').trim().toUpperCase() === String(noRumah).trim().toUpperCase() &&
                formatPeriodeBulan(m.periode || '') === formatPeriodeBulan(periode || '')
            );
            nomInput.value = meterRec ? (Number(meterRec.totalTagihan) || 0) : 0;
        }

