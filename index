        function syncDataToGoogleSheets(silent = false, specificSheetName = null) {
            const cfg = getCloudConfig();
            const url = cfg.url;
            const secretToken = cfg.token;
            
            if (url) {
                localStorage.setItem('tamaland_gas_url', url);
                localStorage.setItem('tamaland_gas_token', secretToken);
                if (!state.identitas) state.identitas = {};
                state.identitas.cloudScriptUrl = url;
                state.identitas.cloudSecretToken = secretToken;
                saveToLocalStorage();
            }

            if (!url) {
                if (!silent) {
                    Swal.fire({ icon: 'warning', title: 'URL Kosong', text: 'Masukkan Google Apps Script Web App URL terlebih dahulu pada menu Setup!' });
                }
                return;
            }

            const statusText = document.getElementById('gsheetStatusText');
            const statusBadge = document.getElementById('gsheetStatusBadge');
            if (statusText) statusText.innerText = 'Menyinkronkan...';
            if (statusBadge) {
                statusBadge.className = 'flex items-center space-x-1 bg-amber-500/20 border border-amber-400/30 px-2 py-1 rounded-lg text-[9px] font-bold text-amber-300';
            }

            if (!silent) {
                showLoadingOverlay('Menyinkronkan ke Cloud...', 'Mengirim seluruh tabel secara terproteksi ke Google Sheets...');
            }

            const payloadData = {
                Identitas: [
                    ["Key", "Value"],
                    ["Nama Perumahan", state.identitas?.namaPerumahan || 'Perumahan Tamaland'],
                    ["Alamat", state.identitas?.alamat || ''],
                    ["Logo URL", state.identitas?.logoUrl || ''],
                    ["TTD Bendahara URL", state.identitas?.ttdBendaharaUrl || ''],
                    ["No Rekening", state.identitas?.noRekening || ''],
                    ["QRIS URL", state.identitas?.qrisUrl || ''],
                    ["Visual Theme", state.identitas?.theme || 'blue'],
                    ["Role Permissions JSON", JSON.stringify(state.rolePermissions || {})]
                ],
                Warga: [
                    ["ID", "No Rumah", "Nama Kepala Keluarga", "Nama Jalan", "Anggota Jiwa", "No WhatsApp", "Kategori", "Password", "Gambar KK URL / Base64", "Status Hunian", "Foto Selfie URL / Base64"],
                    ...(state.wargaList || []).map(w => [w.id, w.noRumah, w.nama, w.jalan, w.anggota, w.wa, w.kategori, w.pass, w.kkUrl || '', w.statusHunian || 'Dihuni', w.selfieUrl || ''])
                ],
                TarifIuran: [
                    ["ID", "Nama Komponen", "Nominal", "Wajib"],
                    ...(state.iuranList || []).map(i => [i.id, i.nama, i.nominal, i.wajib])
                ],
                Transaksi: [
                    ["ID Resi", "No Rumah", "Nama", "Kategori ID", "Bulan", "Nominal", "Tanggal", "Metode"],
                    ...(state.transaksiList || []).map(t => [t.id, t.noRumah, t.nama, t.categoryId || '1', formatPeriodeBulan(t.bulan || t.tanggal), t.nominal, formatCleanDate(t.tanggal), t.metode])
                ],
                Pengeluaran: [
                    ["ID Pengeluaran", "Tanggal", "Kategori", "Deskripsi", "Nominal"],
                    ...(state.pengeluaranList || []).map(p => [p.id, formatCleanDate(p.tanggal), p.kategori, p.desc, p.nominal])
                ],
                Pengurus: [
                    ["ID", "Nama", "Jabatan", "Username", "Password", "No Rumah", "No WhatsApp"],
                    ...(state.pengurusList || []).map(pr => [pr.id, pr.nama, pr.jabatan, pr.username || '', pr.password || '', pr.noRumah || '', pr.wa || ''])
                ],
                Rating: [
                    ["ID", "No Rumah", "Nama Warga", "Bintang", "Ulasan", "Tanggal"],
                    ...(state.ratingList || []).map(r => [r.id, r.noRumah, r.nama, r.bintang, r.ulasan, r.tanggal])
                ],
                MeterAir: [
                    ["ID Meter", "No Rumah", "Nama Warga", "Periode", "Stand Awal", "Stand Akhir", "Kubikasi", "Tarif per m3", "Total Tagihan"],
                    ...(state.meterAirList || []).map(m => [m.id, m.noRumah, m.nama, formatPeriodeBulan(m.periode), m.standAwal, m.standAkhir, m.kubikasi, m.tarifPerM3, m.totalTagihan])
                ],
                LogAkses: [
                    ["ID Log", "Waktu (WIB)", "ID / Blok User", "Nama Pengguna", "Peran / Jabatan", "Aktivitas", "Status", "Perangkat"],
                    ...(state.accessLogList || []).map(l => [l.id, l.waktu, l.userId, l.nama, l.role, l.aktivitas, l.status, l.device || '-'])
                ],
                Pesan: [
                    ["ID Pesan", "Tujuan", "Penerima", "Judul", "Isi Pesan", "Pengirim", "Waktu", "Dibaca Oleh JSON"],
                    ...(state.pesanList || []).map(p => [p.id, p.tujuan, p.penerimaNama || p.tujuan, p.judul, p.isi, p.pengirim, p.waktu, JSON.stringify(p.dibacaOleh || [])])
                ]
            };

            const sheetsToSync = specificSheetName ? [specificSheetName] : Object.keys(payloadData);

            const syncPromises = sheetsToSync.map(sheetName => {
                return fetchWithTimeout(url, {
                    method: 'POST',
                    mode: 'no-cors',
                    headers: { 'Content-Type': 'text/plain;charset=utf-8' },
                    body: JSON.stringify({
                        action: 'clearAndSync',
                        secretToken: secretToken,
                        timezone: 'Asia/Jakarta',
                        sheet: sheetName,
                        headers: payloadData[sheetName][0],
                        rows: payloadData[sheetName].slice(1)
                    })
                }, 15000);
            });

            Promise.all(syncPromises).then(() => {
                if (statusText) statusText.innerText = 'Cloud Synced';
                if (statusBadge) {
                    statusBadge.className = 'flex items-center space-x-1 bg-emerald-500/20 border border-emerald-400/30 px-2 py-1 rounded-lg text-[9px] font-bold text-emerald-300';
                }
