                        } catch (err) {
                            if (inputElem) inputElem.value = '';
                            Swal.fire({ icon: 'error', title: 'Gagal Membaca File .XLSX', text: 'Pastikan berkas Excel (.xlsx / .xls) valid dan tidak rusak.' });
