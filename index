        function openModalKwitansi(trxId) {
            const trx = (state.transaksiList || []).find(t => String(t.id) === String(trxId));
            if (!trx) return;
            activeKwitansiTrxId = trx.id;
            const warga = (state.wargaList || []).find(w => String(w.noRumah || '').trim().toUpperCase() === String(trx.noRumah || '').trim().toUpperCase());
            const isAir = trx.categoryId === 'air' || (trx.metode || '').toLowerCase().includes('air');
            const isKurangBayar = trx.statusBayar === 'Kurang Bayar' || trx.statusBayar === 'Belum Lunas / Kurang Bayar';
            const isLunas = !isKurangBayar && (trx.statusBayar === 'Lunas' || trx.statusBayar === 'Sudah Dilunasi');
            const nomDibayar = Number(trx.nominalDibayarSekarang !== undefined ? trx.nominalDibayarSekarang : trx.nominal) || 0;
            const tarifSeharusnya = Number(trx.tarifSeharusnya) || (isAir ? nomDibayar : getWargaTarifSeharusnya(warga, trx.categoryId || '1'));
            const kekurangan = isKurangBayar ? (Number(trx.kekurangan) || Math.max(0, tarifSeharusnya - nomDibayar)) : 0;

            if (document.getElementById('kwNoResi')) document.getElementById('kwNoResi').innerText = `#${trx.id}`;
            if (document.getElementById('kwTgl')) document.getElementById('kwTgl').innerText = formatCleanDate(trx.tanggal);
            if (document.getElementById('kwNamaWarga')) document.getElementById('kwNamaWarga').innerText = trx.nama || (warga ? warga.nama : '-');
            if (document.getElementById('kwBlok')) document.getElementById('kwBlok').innerText = trx.noRumah || '-';
            if (document.getElementById('kwKategoriWarga')) document.getElementById('kwKategoriWarga').innerText = warga?.kategori || 'Mampu (Bayar Full)';
            if (document.getElementById('kwJenisIuran')) document.getElementById('kwJenisIuran').innerText = isAir ? 'Tagihan Air Bersih' : 'Iuran Wajib Warga';
            if (document.getElementById('kwPeriode')) document.getElementById('kwPeriode').innerText = formatPeriodeBulan(trx.bulan || '-');
            if (document.getElementById('kwTarifTagihan')) document.getElementById('kwTarifTagihan').innerText = formatRupiah(tarifSeharusnya > 0 ? tarifSeharusnya : nomDibayar);
            if (document.getElementById('kwNominal')) document.getElementById('kwNominal').innerText = formatRupiah(nomDibayar);
            if (document.getElementById('kwSubDetailStatus')) {
                document.getElementById('kwSubDetailStatus').innerText = isKurangBayar && kekurangan > 0
                    ? `Metode: ${trx.metode || 'Cash'} • Kekurangan: ${formatRupiah(kekurangan)}`
                    : `Metode: ${trx.metode || 'Cash'}`;
            }

            const statusBadge = document.getElementById('kwBadgeStatus');
            if (statusBadge) {
                if (isLunas) {
                    statusBadge.innerText = 'LUNAS';
                    statusBadge.className = 'px-2 py-0.5 bg-emerald-100 text-emerald-800 text-[10px] font-bold rounded';
                } else if (isKurangBayar) {
                    statusBadge.innerText = 'BELUM LUNAS / KURANG BAYAR';
                    statusBadge.className = 'px-2 py-0.5 bg-orange-100 text-orange-800 text-[10px] font-bold rounded';
                } else {
                    statusBadge.innerText = 'BELUM LUNAS';
                    statusBadge.className = 'px-2 py-0.5 bg-amber-100 text-amber-800 text-[10px] font-bold rounded';
                }
            }

            document.getElementById('modalKwitansi')?.classList.remove('hidden');
            if (typeof lucide !== 'undefined' && lucide.createIcons) lucide.createIcons();
        }

