        function submitBayarMandiriWarga(e) {
            if (e) e.preventDefault();
            if (!currentWargaUser) return;
            const categoryId = document.getElementById('mandiriJenisSelect')?.value || '1';
            const tanggalTransfer = document.getElementById('mandiriTanggalInput')?.value || getTodayJakartaISO();
            const bulan = document.getElementById('mandiriPeriodeSelect')?.value || 'November 2026';
            const nominal = Number(document.getElementById('mandiriNominalInput')?.value) || 0;
            const fileInput = document.getElementById('mandiriBuktiInput');

            if (!fileInput || !fileInput.files || !fileInput.files[0]) return;
            const check = validateImageFile(fileInput.files[0], 5);
            if (!check.valid) {
                Swal.fire({ icon: 'error', title: 'Validasi File Gagal', text: check.message });
                return;
            }

            compressImageAndSave(fileInput.files[0], compressedBukti => {
                const tarifSeharusnya = getWargaTarifSeharusnya(currentWargaUser, categoryId);
                const isKurang = categoryId !== 'air' && tarifSeharusnya > 0 && nominal < tarifSeharusnya;
                const kekurangan = isKurang ? Math.max(0, tarifSeharusnya - nominal) : 0;

                state.transaksiList.unshift({
                    id: generateUniqueId('INV'),
                    noRumah: currentWargaUser.noRumah,
                    nama: currentWargaUser.nama,
                    categoryId,
                    bulan,
                    tarifSeharusnya,
                    nominal,
                    nominalDibayarSekarang: nominal,
                    kekurangan,
                    tanggal: tanggalTransfer,
                    metode: 'Transfer Mandiri',
                    validasiAdmin: 'Menunggu Validasi',
                    statusBayar: isKurang ? 'Belum Lunas / Kurang Bayar' : 'Belum Lunas',
                    buktiUrl: compressedBukti
                });
                saveToLocalStorage();
                renderWargaPortalView();
                updateHeaderStats();
                syncDataToGoogleSheets(true, 'Transaksi');
                document.getElementById('modalBayarMandiriWarga').classList.add('hidden');
                Swal.fire({ icon: 'success', title: 'Bukti Transfer Terkirim', timer: 1500, showConfirmButton: false });
            });
        }

