        function submitPelunasanKekurangan(e) {
            if (e) e.preventDefault();
            if (!settlingTransaksiId) return;

            const idx = (state.transaksiList || []).findIndex(t => String(t.id) === String(settlingTransaksiId));
            if (idx === -1) return;

            const nominalTambahan = Number(document.getElementById('lunasNominalInput')?.value) || 0;
            const tanggalPelunasan = document.getElementById('lunasTanggalInput')?.value || getTodayJakartaISO();
            const metodePelunasan = document.getElementById('lunasMetodeSelect')?.value || 'Cash';

            if (nominalTambahan <= 0) {
                Swal.fire({ icon: 'warning', title: 'Nominal Tidak Valid', text: 'Masukkan nominal pelunasan lebih dari Rp 0.' });
                return;
            }

            const existing = state.transaksiList[idx];
            const warga = (state.wargaList || []).find(w => String(w.noRumah || '').trim().toUpperCase() === String(existing.noRumah || '').trim().toUpperCase());
            const prevDibayar = Number(existing.nominalDibayarSekarang !== undefined ? existing.nominalDibayarSekarang : existing.nominal) || 0;
            const tarifSeharusnya = Number(existing.tarifSeharusnya) || getWargaTarifSeharusnya(warga, existing.categoryId || '1') || (prevDibayar + (Number(existing.kekurangan) || 0));
            const totalTerbayarBaru = prevDibayar + nominalTambahan;
            const sisaKekuranganBaru = Math.max(0, tarifSeharusnya - totalTerbayarBaru);
            const sudahLunas = sisaKekuranganBaru <= 0;

            state.transaksiList[idx] = {
                ...existing,
                tanggal: tanggalPelunasan,
                metode: metodePelunasan,
                tarifSeharusnya,
                nominal: totalTerbayarBaru,
                nominalDibayarSekarang: totalTerbayarBaru,
                kekurangan: sisaKekuranganBaru,
                statusBayar: sudahLunas ? 'Lunas' : 'Belum Lunas / Kurang Bayar',
                validasiAdmin: 'Disetujui'
            };

            const settledId = existing.id;
            saveToLocalStorage();
            renderTableTransaksi(false);
            renderTableBayarAir();
            renderMatriksTunggakan(false);
            renderLaporanKas(false);
            updateHeaderStats();
            syncDataToGoogleSheets(true, 'Transaksi');
            closeModalPelunasanKekurangan();

            Swal.fire({
                icon: 'success',
                title: sudahLunas ? 'Sisa Kekurangan Lunas!' : 'Pelunasan Sebagian Tercatat',
                text: sudahLunas
                    ? `Transaksi #${settledId} kini berstatus Lunas (${formatRupiah(totalTerbayarBaru)}).`
                    : `Pembayaran ${formatRupiah(nominalTambahan)} tercatat. Sisa kekurangan: ${formatRupiah(sisaKekuranganBaru)}.`,
                timer: 1600,
                showConfirmButton: false
            });
        }

