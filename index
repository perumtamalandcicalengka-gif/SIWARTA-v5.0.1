                    state.identitas.cloudScriptUrl = DEFAULT_CLOUD_SCRIPT_URL;
                    state.identitas.cloudSecretToken = DEFAULT_CLOUD_SECRET_TOKEN;
                    saveToLocalStorage();
                }
                updateCloudConfigSummaryBadge();

                if (typeof lucide !== 'undefined' && lucide.createIcons) {
                    lucide.createIcons();
                }

                startJakartaLiveClock();
                updateJakartaTimezoneUI();

                setTimeout(() => {
                    pullDataFromSheetSilent();
                }, 300);

                window.addEventListener('error', (event) => {
                    console.warn('Global error ditangkap dengan aman:', event.message || event.error);
                });

                window.addEventListener('unhandledrejection', (event) => {
                    console.warn('Unhandled promise rejection ditangkap dengan aman:', event.reason);
                });
            } catch (err) {
