        function renderTableAccessLog() {
            const tbody = document.getElementById('tblAccessLogBody');
            if (!tbody) return;
            tbody.innerHTML = '';

            const search = (document.getElementById('searchAccessLogInput')?.value || '').toLowerCase();
            const roleFilter = document.getElementById('filterAccessLogRole')?.value || '';

            const list = (state.accessLogList || []).filter(item => {
                const text = `${item.userId} ${item.nama} ${item.role} ${item.aktivitas} ${item.status} ${item.waktu}`.toLowerCase();
                const matchSearch = text.includes(search);
                const matchRole = !roleFilter || (roleFilter === 'Warga' ? item.role === 'Warga' : item.role !== 'Warga');
                return matchSearch && matchRole;
            });

            if (document.getElementById('totalAccessLogBadge')) {
                document.getElementById('totalAccessLogBadge').innerText = list.length;
            }

            if (list.length === 0) {
                tbody.innerHTML = `<tr><td colspan="5" class="p-6 text-center text-slate-400">Belum ada catatan log akses pengguna.</td></tr>`;
                return;
            }

            list.forEach(item => {
                const isSuccess = item.status === 'Berhasil';
                const isWarga = item.role === 'Warga';
                const statusBadge = isSuccess
                    ? `<span class="px-2 py-0.5 bg-emerald-100 text-emerald-800 font-bold rounded text-[10px]">${escapeHTML(item.status)}</span>`
                    : `<span class="px-2 py-0.5 bg-rose-100 text-rose-800 font-bold rounded text-[10px]">${escapeHTML(item.status)}</span>`;

                const roleBadge = isWarga
                    ? `<span class="px-2 py-0.5 bg-sky-100 text-sky-800 font-bold rounded text-[10px]">Warga</span>`
                    : `<span class="px-2 py-0.5 bg-indigo-100 text-indigo-800 font-bold rounded text-[10px]">${escapeHTML(item.role)}</span>`;

                const tr = document.createElement('tr');
                tr.innerHTML = `
                    <td class="p-3 font-mono text-slate-600 whitespace-nowrap">${escapeHTML(item.waktu)}</td>
                    <td class="p-3 font-bold text-slate-800">${escapeHTML(item.nama)} <span class="block text-[9px] font-mono text-brand-600">${escapeHTML(item.userId)}</span></td>
                    <td class="p-3">${roleBadge}</td>
                    <td class="p-3 text-slate-700">${escapeHTML(item.aktivitas)} <span class="block text-[9px] text-slate-400">${escapeHTML(item.device || '-')}</span></td>
                    <td class="p-3">${statusBadge}</td>
                `;
                tbody.appendChild(tr);
            });
            if (typeof lucide !== 'undefined' && lucide.createIcons) lucide.createIcons();
        }

