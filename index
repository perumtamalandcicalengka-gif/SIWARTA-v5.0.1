                            t.statusBayar === 'Lunas' ||
                            t.statusBayar === 'Sudah Dilunasi' ||
                            (t.metode === 'Transfer Mandiri' && t.validasiAdmin === 'Disetujui' && t.statusBayar !== 'Belum Lunas')
