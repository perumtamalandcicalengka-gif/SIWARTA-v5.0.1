            const myMessages = (state.pesanList || []).filter(p => 
                p.tujuan === 'SEMUA' || String(p.tujuan || '').trim().toUpperCase() === noRumahUpper
            );

            const unreadCount = myMessages.filter(p => !(p.dibacaOleh || []).includes(noRumahUpper)).length;
            if (unreadBadge) {
                if (unreadCount > 0) {
                    unreadBadge.innerText = `${unreadCount} Baru`;
                    unreadBadge.classList.remove('hidden');
                } else {
                    unreadBadge.classList.add('hidden');
                }
            }

            if (myMessages.length === 0) {
                container.innerHTML = `<div class="p-4 text-center text-slate-400 text-[11px] bg-slate-50 rounded-xl border border-slate-100">Belum ada pesan masuk dari pengurus.</div>`;
