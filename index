        function submitPesanAdmin(e) {
            if (e) e.preventDefault();
            const tujuan = document.getElementById('pesanTujuanSelect')?.value || 'SEMUA';
            const judul = document.getElementById('pesanJudulInput')?.value.trim();
            const isi = document.getElementById('pesanIsiInput')?.value.trim();

            if (!judul || !isi) {
                Swal.fire({ icon: 'warning', title: 'Form Belum Lengkap', text: 'Isi judul dan pesan terlebih dahulu!' });
                return;
            }

            const pWib = getJakartaDateParts(new Date());
            const waktuStr = `${pWib.year}-${pWib.month}-${pWib.day} ${pWib.hour}:${pWib.minute} WIB`;
            const pengirimNama = document.getElementById('sidebarProfileName')?.innerText || currentAdminRole || 'Pengurus Tamaland';

            let penerimaNama = 'Semua Warga';
            if (tujuan !== 'SEMUA') {
                const targetW = (state.wargaList || []).find(w => String(w.noRumah || '').trim().toUpperCase() === tujuan);
                penerimaNama = targetW ? `${tujuan} - ${targetW.nama}` : tujuan;
            }

            const newPesan = {
                id: generateUniqueId('MSG'),
                tujuan,
                penerimaNama,
                judul,
                isi,
                pengirim: pengirimNama,
                waktu: waktuStr,
                dibacaOleh: [],
                dibacaDetail: {}
            };

            if (!state.pesanList) state.pesanList = [];
            state.pesanList.unshift(newPesan);

            saveToLocalStorage();
            renderTablePesanAdmin();
            syncDataToGoogleSheets(true, 'Pesan');
            closeModalBuatPesanAdmin();

            Swal.fire({
                icon: 'success',
                title: 'Pesan Terkirim',
                text: `Pesan "${judul}" berhasil dikirim ke kotak pesan portal warga!`,
                timer: 1500,
                showConfirmButton: false
            });
        }

