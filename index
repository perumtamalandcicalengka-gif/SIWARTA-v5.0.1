        function downloadLaporanPDF() {
            if (typeof window.jspdf === 'undefined') {
                Swal.fire({ icon: 'error', title: 'Library PDF Belum Siap', text: 'jsPDF belum termuat.' });
                return;
            }
            const { jsPDF } = window.jspdf;
            const doc = new jsPDF('p', 'mm', 'a4');
            const pageWidth = doc.internal.pageSize.getWidth();
            let currentY = 15;

            const logoUrl = state.identitas?.logoUrl || '';
            if (logoUrl) {
                try {
                    doc.addImage(logoUrl, 'JPEG', 14, currentY, 14, 14);
                } catch (e) {}
            }

            doc.setFontSize(14);
            doc.setFont("helvetica", "bold");
            doc.text((state.identitas?.namaPerumahan || 'PERUMAHAN TAMALAND').toUpperCase(), logoUrl ? 32 : 14, currentY + 6);

            doc.setFontSize(9);
            doc.setFont("helvetica", "normal");
            doc.text("LAPORAN BUKU KAS UMUM & RINCIAN POS", logoUrl ? 32 : 14, currentY + 11);
            doc.text("Alamat: " + (state.identitas?.alamat || '-'), logoUrl ? 32 : 14, currentY + 15);
            doc.text("Zona Waktu: Asia/Jakarta (WIB / GMT+7) • Dicetak: " + formatJakartaFullTimestamp(new Date()), logoUrl ? 32 : 14, currentY + 19);

            currentY += 25;
            doc.setDrawColor(200, 200, 200);
            doc.line(14, currentY, pageWidth - 14, currentY);
            currentY += 6;

            let totalDebet = 0;
            let totalKredit = 0;
            const rows = [];

            (state.transaksiList || []).forEach((t) => {
                const isPending = t.metode === 'Transfer Mandiri' && (t.validasiAdmin === 'Menunggu Validasi' || t.validasiAdmin === 'Pending');
                if (isPending || t.validasiAdmin === 'Ditolak' || t.statusBayar === 'Belum Lunas') return;
                const debetVal = getTransactionCashAmount(t);
                totalDebet += debetVal;
                rows.push([
                    rows.length + 1,
                    formatCleanDate(t.tanggal),
                    t.categoryId === 'air' || t.metode === 'Tagihan Air' ? 'Pos Air' : 'Pos Umum',
                    `${t.noRumah} - ${t.nama} (${formatPeriodeBulan(t.bulan || '-')})`,
                    formatRupiah(debetVal),
                    '-'
                ]);
            });

            (state.pengeluaranList || []).forEach(p => {
                const kreditVal = Number(p.nominal) || 0;
                totalKredit += kreditVal;
                rows.push([
                    rows.length + 1,
                    formatCleanDate(p.tanggal),
                    p.kategori || 'Operasional',
                    p.desc || '-',
                    '-',
                    formatRupiah(kreditVal)
                ]);
            });

            doc.autoTable({
                head: [['No', 'Tanggal', 'Pos/Kategori', 'Uraian Transaksi', 'Debet', 'Kredit']],
                body: rows,
                startY: currentY,
                theme: 'grid',
                styles: { fontSize: 8 },
                headStyles: { fillColor: [2, 132, 199], textColor: [255, 255, 255], fontStyle: 'bold' }
            });

            const finalY = (doc.lastAutoTable && doc.lastAutoTable.finalY) ? doc.lastAutoTable.finalY + 8 : currentY + 30;
            const sisaSaldo = totalDebet - totalKredit;

            doc.setFontSize(10);
            doc.setFont("helvetica", "bold");
            doc.text(`Total Debet  : ${formatRupiah(totalDebet)}`, 14, finalY);
            doc.text(`Total Kredit : ${formatRupiah(totalKredit)}`, 14, finalY + 6);
            doc.text(`Sisa Saldo   : ${formatRupiah(sisaSaldo)}`, 14, finalY + 12);

            doc.save(`Laporan_Kas_Tamaland_${getTodayJakartaISO()}.pdf`);
        }

