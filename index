        async function handleWargaLogin(e) {
            if (e) e.preventDefault();
            const blokInput = (document.getElementById('loginWargaBlok')?.value || '').trim().toUpperCase();
            const passInput = (document.getElementById('loginWargaPass')?.value || '').trim();

            const rateCheck = checkLoginRateLimit('warga:' + blokInput);
            if (rateCheck.locked) {
                Swal.fire({
                    icon: 'warning',
                    title: 'Terlalu Banyak Percobaan Login',
                    text: `Akun blok ${blokInput} dikunci sementara. Coba lagi dalam ${rateCheck.secondsLeft} detik.`
                });
                return;
            }

            const pendingMatch = (state.calonWargaList || []).find(c =>
                String(c.noRumah || '').trim().toUpperCase() === blokInput &&
                (c.statusVerifikasi || 'Menunggu Verifikasi') === 'Menunggu Verifikasi'
            );
            if (pendingMatch) {
                recordAccessLog({
                    userId: blokInput,
                    nama: pendingMatch.nama || blokInput,
                    role: 'Warga',
                    aktivitas: 'Login Warga (Menunggu Verifikasi)',
                    status: 'Menunggu Verifikasi'
                });
                Swal.fire({
                    icon: 'info',
                    title: 'Menunggu Verifikasi Admin',
                    text: 'Akun warga baru Anda sedang ditinjau dan menunggu persetujuan pengurus sebelum dapat masuk ke portal.'
                });
                return;
            }

            const warga = (state.wargaList || []).find(w => String(w.noRumah || '').trim().toUpperCase() === blokInput);
            let isValid = false;
            if (warga) {
                if (warga.pass && String(warga.pass).startsWith('sha256:')) {
                    isValid = await verifyPassword(passInput, warga.pass);
                } else {
                    const defaultPass = warga.pass || 'warga123';
                    isValid = passInput === defaultPass;
                }
            }

            if (!isValid) {
                recordFailedLoginAttempt('warga:' + blokInput);
                recordAccessLog({
                    userId: blokInput || '-',
                    nama: warga ? warga.nama : (blokInput || 'Warga'),
                    role: 'Warga',
                    aktivitas: 'Percobaan Login Portal Warga',
                    status: 'Gagal'
                });
                Swal.fire({ icon: 'error', title: 'Login Gagal', text: 'Nomor rumah atau kata sandi warga tidak sesuai.' });
                return;
            }

            resetLoginAttempts('warga:' + blokInput);
            currentUserRole = 'warga';
            currentWargaUser = warga;

            recordAccessLog({
                userId: warga.noRumah,
                nama: warga.nama,
                role: 'Warga',
                aktivitas: 'Login Portal Mandiri Warga',
                status: 'Berhasil'
            });

            document.getElementById('loginOverlay')?.classList.add('hidden');
            document.getElementById('appTopHeader')?.classList.remove('hidden');
            if (document.getElementById('sidebarProfileName')) document.getElementById('sidebarProfileName').innerText = warga.nama;
            if (document.getElementById('sidebarProfileRole')) document.getElementById('sidebarProfileRole').innerText = `Warga Blok ${warga.noRumah}`;

            buildNavigationMenu();
            showSection('sec-warga-portal');
            renderWargaPortalView();

            const usesDefaultPass = !warga.passwordChanged && (
                !warga.pass ||
                String(warga.pass).trim() === '' ||
                String(warga.pass).trim() === 'warga123' ||
                passInput === 'warga123'
            );
