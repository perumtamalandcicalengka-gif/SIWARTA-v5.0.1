        function submitBayarAir(e) {
            if (e) e.preventDefault();
            const noRumah = document.getElementById('bayarAirWargaSelect')?.value;
            const warga = (state.wargaList || []).find(w => String(w.noRumah || '').trim().toUpperCase() === String(noRumah || '').trim().toUpperCase());
            if (!warga) return;

            const tanggal = document.getElementById('bayarAirTanggalInput')?.value || getTodayJakartaISO();
            const bulan = document.getElementById('bayarAirPeriodeSelect')?.value || 'November 2026';
            const metodeBayar = document.getElementById('bayarAirMetodeSelect')?.value || 'Cash';
            const nominal = Number(document.getElementById('bayarAirNominalInput')?.value) || 0;

            let targetIdx = -1;
            if (activeBayarAirId) {
                targetIdx = (state.transaksiList || []).findIndex(t => String(t.id) === String(activeBayarAirId));
            } else {
                targetIdx = (state.transaksiList || []).findIndex(t =>
                    (t.categoryId === 'air' || t.metode === 'Tagihan Air') &&
                    String(t.noRumah || '').trim().toUpperCase() === warga.noRumah.toUpperCase() &&
                    formatPeriodeBulan(t.bulan || '') === formatPeriodeBulan(bulan) &&
                    t.statusBayar !== 'Lunas'
                );
            }

            let savedId = '';
            if (targetIdx !== -1) {
                const existing = state.transaksiList[targetIdx];
                state.transaksiList[targetIdx] = {
                    ...existing,
                    categoryId: 'air',
                    bulan,
                    nominal,
                    nominalDibayarSekarang: nominal,
                    tanggal,
                    metode: 'Tagihan Air',
                    metodePembayaranAir: metodeBayar,
                    validasiAdmin: 'Disetujui',
                    statusBayar: 'Lunas',
                    kekurangan: 0
                };
                savedId = existing.id;
            } else {
                savedId = generateUniqueId('AIR');
                state.transaksiList.unshift({
                    id: savedId,
                    noRumah: warga.noRumah,
                    nama: warga.nama,
                    categoryId: 'air',
                    bulan,
                    nominal,
                    nominalDibayarSekarang: nominal,
                    tanggal,
                    metode: 'Tagihan Air',
                    metodePembayaranAir: metodeBayar,
                    validasiAdmin: 'Disetujui',
                    statusBayar: 'Lunas',
                    kekurangan: 0
                });
            }

            saveToLocalStorage();
            renderTableBayarAir();
            renderTableTransaksi(false);
            renderMatriksTunggakan(false);
            renderLaporanKas(false);
            updateHeaderStats();
            syncDataToGoogleSheets(true, 'Transaksi');
            closeModalBayarAir();
            openModalKwitansi(savedId);
        }

