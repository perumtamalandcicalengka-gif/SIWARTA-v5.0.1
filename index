        function approveCalonWarga(calonId) {
            const idx = (state.calonWargaList || []).findIndex(c => c.id === calonId);
            if (idx === -1) return;
            const calon = state.calonWargaList[idx];

            const newWarga = {
                id: calon.id || generateUniqueId('w'),
                noRumah: String(calon.noRumah || '').trim().toUpperCase(),
                jalan: String(calon.jalan || 'Jl. Tamaland Utama').trim(),
                nama: String(calon.nama || '').trim(),
                anggota: Number(calon.anggota) || 0,
                wa: String(calon.wa || '').trim(),
                kategori: calon.kategori || 'Mampu (Bayar Full)',
                statusHunian: calon.statusHunian || 'Dihuni',
                pass: calon.pass || 'warga123',
                passwordChanged: Boolean(calon.passwordChanged || (calon.pass && String(calon.pass).startsWith('sha256:'))),
                kkUrl: calon.kkUrl || null,
                selfieUrl: calon.selfieUrl || null
            };

            if (!state.wargaList) state.wargaList = [];
            const existingIdx = state.wargaList.findIndex(w => String(w.noRumah || '').trim().toUpperCase() === newWarga.noRumah);
            if (existingIdx !== -1) {
                state.wargaList[existingIdx] = { ...state.wargaList[existingIdx], ...newWarga };
            } else {
                state.wargaList.push(newWarga);
            }

            state.calonWargaList.splice(idx, 1);
            normalizeAndSortWargaList();
            saveToLocalStorage();
            renderCalonWargaQueue();
            renderTableWarga();
            renderMatriksTunggakan();
            updateHeaderStats();
            populateJalanFilter();

            const cfg = getCloudConfig();
            if (cfg.url) {
                fetch(cfg.url, {
                    method: 'POST',
                    mode: 'no-cors',
                    headers: { 'Content-Type': 'text/plain;charset=utf-8' },
                    body: JSON.stringify({
                        action: 'appendWarga',
                        secretToken: cfg.token,
                        sheet: 'Warga',
                        headers: ["ID", "No Rumah", "Nama Kepala Keluarga", "Nama Jalan", "Anggota Jiwa", "No WhatsApp", "Kategori", "Password", "Gambar KK URL / Base64", "Status Hunian", "Foto Selfie URL / Base64"],
                        row: [
                            newWarga.id,
                            newWarga.noRumah,
                            newWarga.nama,
                            newWarga.jalan,
                            newWarga.anggota,
                            newWarga.wa,
                            newWarga.kategori,
                            newWarga.pass,
                            newWarga.kkUrl || '',
                            newWarga.statusHunian || 'Dihuni',
                            newWarga.selfieUrl || ''
                        ]
                    })
                }).catch(() => {});
            }

            syncDataToGoogleSheets(true, 'Warga');

            Swal.fire({
                icon: 'success',
                title: 'Warga Disetujui',
                text: `Data ${newWarga.noRumah} (${newWarga.nama}) telah disetujui dan disimpan ke database Warga!`,
                timer: 1500,
                showConfirmButton: false
            });
        }

