        function bacaPesanWarga(pesanId) {
            if (!currentWargaUser) return;
            const noRumahUpper = String(currentWargaUser.noRumah || '').trim().toUpperCase();
            const idx = (state.pesanList || []).findIndex(p => p.id === pesanId);
            if (idx === -1) return;

            const pesan = state.pesanList[idx];
            if (!pesan.dibacaOleh) pesan.dibacaOleh = [];
            if (!pesan.dibacaDetail) pesan.dibacaDetail = {};

            const wasUnread = !pesan.dibacaOleh.includes(noRumahUpper);
            if (wasUnread) {
                pesan.dibacaOleh.push(noRumahUpper);
                const pWib = getJakartaDateParts(new Date());
                pesan.dibacaDetail[noRumahUpper] = `${pWib.year}-${pWib.month}-${pWib.day} ${pWib.hour}:${pWib.minute} WIB`;
                saveToLocalStorage();
                renderWargaKotakPesan(currentWargaUser);
                renderTablePesanAdmin();
                syncDataToGoogleSheets(true, 'Pesan');
            }

            Swal.fire({
                title: escapeHTML(pesan.judul),
                html: `
                    <div class="text-left space-y-3 text-xs">
                        <div class="flex items-center justify-between bg-slate-100 px-3 py-2 rounded-lg text-[11px]">
                            <span>Dari: <strong>${escapeHTML(pesan.pengirim || 'Pengurus Tamaland')}</strong></span>
                            <span class="text-slate-500">${escapeHTML(pesan.waktu || '-')}</span>
                        </div>
                        <div class="p-3.5 bg-white border border-slate-200 rounded-xl text-slate-700 leading-relaxed whitespace-pre-line">${escapeHTML(pesan.isi)}</div>
                        <div class="flex items-center justify-end">
                            <span class="px-2.5 py-1 bg-emerald-100 text-emerald-800 font-bold rounded-lg text-[10px] inline-flex items-center gap-1">
                                ✓ Pesan Sudah di Baca
