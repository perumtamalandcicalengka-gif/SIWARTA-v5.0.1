        function renderTableTransaksi(resetPage = true) {
            if (resetPage) paginationState.transaksi = 1;
            const tbody = document.getElementById('tblTransaksiBody');
            if (!tbody) return;
            tbody.innerHTML = '';

            const search = (document.getElementById('searchTransaksiInput')?.value || '').toLowerCase();
            const filterPeriode = (document.getElementById('filterTransaksiPeriode')?.value || '').toLowerCase();

            const list = (state.transaksiList || []).filter(t => {
                const isAir = t.categoryId === 'air' || t.metode === 'Tagihan Air';
                if (isAir) return false;
                const text = `${t.id} ${t.noRumah} ${t.nama} ${t.metode}`.toLowerCase();
                const bStr = formatPeriodeBulan(t.bulan || '').toLowerCase();
                const matchSearch = text.includes(search);
                const matchPeriode = !filterPeriode || bStr.includes(filterPeriode) || String(t.bulan || '').toLowerCase().includes(filterPeriode);
                return matchSearch && matchPeriode;
            });

            if (list.length === 0) {
                tbody.innerHTML = `<tr><td colspan="9" class="p-6 text-center text-slate-400">Belum ada data transaksi pembayaran iuran.</td></tr>`;
                renderPaginationControls('paginationTransaksi', 'transaksi', 0);
                return;
            }

            const totalPages = Math.max(1, Math.ceil(list.length / PAGE_SIZE));
            if (paginationState.transaksi > totalPages) paginationState.transaksi = totalPages;
            const startIndex = (paginationState.transaksi - 1) * PAGE_SIZE;
            const pageList = list.slice(startIndex, startIndex + PAGE_SIZE);

            pageList.forEach(t => {
                const safeId = escapeHTML(t.id);
                const isPending = t.metode === 'Transfer Mandiri' && (t.validasiAdmin === 'Menunggu Validasi' || t.validasiAdmin === 'Pending');
                const isDitolak = t.validasiAdmin === 'Ditolak';
                const statusBayar = t.statusBayar || 'Lunas';
                const isKurangBayar = statusBayar === 'Kurang Bayar' || statusBayar === 'Belum Lunas / Kurang Bayar';
                const kurangNom = Number(t.kekurangan) || 0;

                let statusBadge = `<span class="px-2 py-0.5 bg-emerald-100 text-emerald-800 font-bold rounded text-[10px]">Lunas</span>`;
                if (isPending) {
                    statusBadge = `<span class="px-2 py-0.5 bg-amber-100 text-amber-800 font-bold rounded text-[10px] animate-pulse">Menunggu Validasi</span>`;
                } else if (isDitolak) {
                    statusBadge = `<span class="px-2 py-0.5 bg-rose-100 text-rose-800 font-bold rounded text-[10px]">Ditolak</span>`;
                } else if (isKurangBayar) {
                    statusBadge = `<span class="px-2 py-0.5 bg-orange-100 text-orange-800 font-bold rounded text-[10px]" title="Kekurangan: ${formatRupiah(kurangNom)}">Belum Lunas / Kurang Bayar${kurangNom > 0 ? ' (' + formatRupiah(kurangNom) + ')' : ''}</span>`;
                } else if (statusBayar === 'Belum Lunas') {
                    statusBadge = `<span class="px-2 py-0.5 bg-amber-100 text-amber-800 font-bold rounded text-[10px]">Belum Lunas</span>`;
                }

                const tr = document.createElement('tr');
                tr.innerHTML = `
