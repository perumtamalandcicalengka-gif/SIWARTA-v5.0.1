        async function saveWarga(e) {
            if (e) e.preventDefault();
            const noRumah = document.getElementById('wargaNoRumahInput')?.value.trim().toUpperCase();
            const jalan = document.getElementById('wargaJalanInput')?.value.trim();
            const nama = document.getElementById('wargaNamaInput')?.value.trim();
            const statusHunian = document.getElementById('wargaStatusHunianInput')?.value;
            const anggota = statusHunian === 'Kosong' ? 0 : (Number(document.getElementById('wargaAnggotaInput')?.value) || 1);
            const wa = document.getElementById('wargaWaInput')?.value.trim();
            const kategori = document.getElementById('wargaKategoriInput')?.value;
            const passRaw = document.getElementById('wargaPassInput')?.value.trim();
            const fileInput = document.getElementById('wargaFileKKInput');

            if (!noRumah || !nama) {
                Swal.fire({ icon: 'warning', title: 'Data Belum Lengkap', text: 'Masukkan No Rumah dan Nama Kepala Keluarga!' });
                return;
            }

            if (fileInput && fileInput.files && fileInput.files[0]) {
                const checkFile = validateImageFile(fileInput.files[0], 5);
                if (!checkFile.valid) {
                    Swal.fire({ icon: 'error', title: 'Validasi File KK Gagal', text: checkFile.message });
                    fileInput.value = '';
                    return;
                }
            }

            let finalPass = 'warga123';
            if (editingWargaId) {
                const existing = (state.wargaList || []).find(w => w.id === editingWargaId);
                if (!passRaw) {
                    finalPass = existing ? existing.pass : 'warga123';
                } else if (passRaw === 'warga123') {
                    finalPass = 'warga123';
                } else {
                    finalPass = await hashPasswordSHA256(passRaw);
                }
            } else {
                finalPass = (!passRaw || passRaw === 'warga123') ? 'warga123' : await hashPasswordSHA256(passRaw);
            }

            const processSave = (kkUrl = null) => {
                if (editingWargaId) {
                    const idx = (state.wargaList || []).findIndex(w => w.id === editingWargaId);
                    if (idx !== -1) {
                        state.wargaList[idx] = {
                            ...state.wargaList[idx],
                            noRumah,
                            jalan,
                            nama,
                            anggota,
                            wa,
                            kategori,
                            statusHunian,
                            pass: finalPass,
                            kkUrl: kkUrl || state.wargaList[idx].kkUrl
                        };
                    }
                } else {
                    state.wargaList.push({
                        id: generateUniqueId('w'),
                        noRumah,
                        jalan,
                        nama,
                        anggota,
                        wa,
                        kategori,
                        statusHunian,
                        pass: finalPass,
                        kkUrl
                    });
                }

                normalizeAndSortWargaList();
                saveToLocalStorage();
                renderTableWarga();
                renderMatriksTunggakan();
                updateHeaderStats();
                populateJalanFilter();
                syncDataToGoogleSheets(true, 'Warga');
                closeModalWarga();

                Swal.fire({ icon: 'success', title: 'Berhasil', text: 'Data warga berhasil disimpan!', timer: 1200, showConfirmButton: false });
            };

            if (fileInput && fileInput.files && fileInput.files[0]) {
                compressImageAndSave(fileInput.files[0], compressedKkUrl => processSave(compressedKkUrl));
            } else {
                processSave(null);
            }
        }

