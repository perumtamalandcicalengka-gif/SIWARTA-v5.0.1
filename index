        function pullDataFromSheet() {
            const cfg = getCloudConfig();
            const url = cfg.url;
            const secretToken = cfg.token;
            if (!url) {
                Swal.fire({ icon: 'warning', title: 'URL Kosong', text: 'Masukkan Google Apps Script Web App URL terlebih dahulu!' });
                return;
            }

            localStorage.setItem('tamaland_gas_url', url);
            localStorage.setItem('tamaland_gas_token', secretToken);
            if (!state.identitas) state.identitas = {};
            state.identitas.cloudScriptUrl = url;
            state.identitas.cloudSecretToken = secretToken;
            saveToLocalStorage();

            showLoadingOverlay('Menarik Data dari Cloud...', 'Mengambil seluruh tabel dengan validasi Secret Token...');
            const fetchUrl = url + (url.includes('?') ? '&' : '?') + 'token=' + encodeURIComponent(secretToken);

            fetchWithTimeout(fetchUrl, {}, 15000)
                .then(res => res.json())
                .then(res => {
                    hideLoadingOverlay();
                    if (res.status === 'unauthorized') {
                        Swal.fire({ icon: 'error', title: 'Akses Cloud Ditolak (401)', text: res.message || 'Secret Token tidak cocok dengan Google Apps Script!' });
                        return;
                    }
                    pullDataFromSheetSilent();
                    Swal.fire({ icon: 'success', title: 'Sinkronisasi Selesai', text: 'Data cloud berhasil ditarik dengan aman!', timer: 1200, showConfirmButton: false });
                })
                .catch(() => {
                    hideLoadingOverlay();
                    Swal.fire({ icon: 'error', title: 'Gagal Menarik Data', text: 'Periksa koneksi atau token akses.' });
                });
        }

